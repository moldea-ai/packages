{
  "name": "@moldea.ai/core",
  "version": "7.0.0",
  "description": "Source-neutral, deterministic interpretation and indexing of moldea repositories.",
  "homepage": "https://github.com/moldea-ai/packages/tree/main/projects/core#readme",
  "bugs": {
    "url": "https://github.com/moldea-ai/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldea-ai/packages.git",
    "directory": "projects/core"
  },
  "license": "MIT",
  "author": "Jesus Graterol",
  "type": "module",
  "sideEffects": false,
  "files": [
    "cover.png",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.js"
    },
    "./scope": {
      "types": "./dist/scope/index.d.ts",
      "import": "./dist/scope.js"
    }
  },
  "main": "./dist/index.js",
  "imports": {
    "#moldea-core-runner": "./dist/node-runner.js",
    "#moldea-core-analysis-worker": "./dist/analysis-worker.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build --emptyOutDir && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "pnpm run build && vitest run --config vitest/test-integration.config.ts",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moldea.ai/repository": "workspace:^2.0.0",
    "error-message-utils": "1.2.11",
    "yaml": "2.9.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
