---
import { ArrowLeft, Maximize2, X } from '@lucide/astro';

import ActionButton, {
  type Props as IActionButtonProps,
} from '../action-button/action-button.component.astro';

// consumers own the unique document ID, trigger copy, and slotted dialog content
export interface Props {
  id: string;
  title: string;
  description?: string;
  triggerLabel: string;
  triggerAriaLabel?: string;
  triggerVariant?: IActionButtonProps['variant'];
  triggerSize?: 'compact' | IActionButtonProps['size'];
  triggerClass?: string;
  size?: 'medium' | 'large';
  closeLabel?: string;
  fallbackOpen?: boolean;
  // matches the platform's opt-in dismissal for read-only content
  isOverlayCloseEnabled?: boolean;
}

const {
  id,
  title,
  description,
  triggerLabel,
  triggerAriaLabel,
  triggerVariant = 'outline',
  triggerSize = 'compact',
  triggerClass,
  size = 'medium',
  closeLabel = 'Close dialog',
  fallbackOpen = false,
  isOverlayCloseEnabled = false,
} = Astro.props;
const isIconTrigger = triggerSize === 'icon' || triggerSize === 'icon-xs';
---

<div data-dialog-root>
  <ActionButton
    variant={triggerVariant}
    size={triggerSize === 'compact' ? 'sm' : triggerSize}
    class:list={[
      triggerSize === 'compact' ? 'py-1 text-xs [hidden]:hidden' : '[hidden]:hidden',
      triggerClass,
    ]}
    aria-label={triggerAriaLabel}
    title={isIconTrigger ? triggerLabel : undefined}
    aria-controls={id}
    aria-haspopup="dialog"
    data-dialog-trigger
    hidden
  >
    {
      isIconTrigger ? (
        <>
          <slot name="trigger-icon">
            <Maximize2
              class="size-4"
              aria-hidden="true"
            />
          </slot>
          <span class="sr-only">{triggerLabel}</span>
        </>
      ) : (
        <slot name="trigger">{triggerLabel}</slot>
      )
    }
  </ActionButton>
  <dialog
    id={id}
    class:list={[
      'fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none grid-rows-[auto_minmax(0,1fr)] overflow-hidden border-0 bg-background p-0 text-foreground outline-none [--dialog-exit-duration:300ms] [--dialog-motion-transform:translateY(0.25rem)] backdrop:bg-transparent open:grid sm:m-auto sm:h-fit sm:max-h-[calc(100dvh-2rem)] sm:w-[calc(100vw-2rem)] sm:rounded-xl sm:border sm:shadow-raised sm:[--dialog-exit-duration:200ms] sm:[--dialog-motion-transform:translateY(0.5rem)_scale(0.95)] sm:backdrop:bg-black/45 sm:backdrop:backdrop-blur-xs dark:sm:backdrop:bg-black/70',
      size === 'large' ? 'sm:max-w-5xl' : 'sm:max-w-2xl',
    ]}
    aria-labelledby={`${id}-title`}
    aria-describedby={description ? `${id}-description` : undefined}
    data-website-ui-dialog
    data-overlay-close-enabled={isOverlayCloseEnabled ? '' : undefined}
    data-dialog-fallback-open={fallbackOpen ? '' : undefined}
    open={fallbackOpen ? true : undefined}
  >
    <header
      class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-2 border-b pt-[max(0.5rem,env(safe-area-inset-top))] pr-[max(0.5rem,env(safe-area-inset-right))] pb-4 pl-[max(0.5rem,env(safe-area-inset-left))] sm:grid-cols-[minmax(0,1fr)_auto] sm:px-6 sm:py-4"
    >
      <div class="col-start-2 row-start-1 flex min-h-9 min-w-0 items-center sm:col-start-1">
        <slot name="heading">
          <h2
            id={`${id}-title`}
            class="min-w-0 text-lg font-semibold"
          >
            {title}
          </h2>
        </slot>
      </div>
      <form
        method="dialog"
        class="col-start-1 row-start-1 sm:col-start-2"
        data-dialog-close-form
      >
        <ActionButton
          type="submit"
          variant="ghost"
          size="icon"
          class="size-9 sm:size-7 sm:rounded-md"
          aria-label={closeLabel}
          autofocus
        >
          <ArrowLeft
            class="size-4 sm:hidden"
            aria-hidden="true"
          />
          <X
            class="hidden size-4 sm:block"
            aria-hidden="true"
          />
        </ActionButton>
      </form>
      {
        description && (
          <p
            id={`${id}-description`}
            class="col-span-2 mt-1 px-2 text-sm leading-6 text-muted-foreground sm:px-0"
          >
            {description}
          </p>
        )
      }
    </header>
    <div
      class="min-h-0 min-w-0 overflow-y-auto overscroll-contain p-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-6"
    >
      <slot />
    </div>
  </dialog>
</div>

<script>
  const activeReturnTransitions = new Set<ViewTransition>();
  const returnAttribute = 'data-website-ui-dialog-return';

  /** Enhances optional detail triggers while native dialogs own modality and keyboard focus. */
  const initializeDialogs = (): void => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-dialog-root]')) {
      if (root.dataset['enhanced'] === 'true') continue;
      const trigger = root.querySelector<HTMLButtonElement>(':scope > [data-dialog-trigger]');
      const dialog = root.querySelector<HTMLDialogElement>(':scope > dialog');
      if (trigger === null || dialog === null || typeof dialog.showModal !== 'function') continue;
      const body = dialog.querySelector<HTMLElement>(':scope > div');
      if (body === null) continue;

      let closeRequest: symbol | undefined;
      let returnTransition: ViewTransition | undefined;
      const clearReturnMarker = (): void => {
        if (document.documentElement.getAttribute(returnAttribute) === dialog.id)
          document.documentElement.removeAttribute(returnAttribute);
      };
      /**
       * Captures the opaque mobile modal before revealing the page, or awaits the desktop exit.
       * @returns A promise that resolves after dismissal or invalidation by a newer session.
       */
      const requestClose = async (): Promise<void> => {
        if (!dialog.open || closeRequest !== undefined) return;
        const request = Symbol();
        closeRequest = request;
        if (window.matchMedia?.('(max-width: 639px)').matches) {
          if (
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            typeof document.startViewTransition !== 'function'
          ) {
            dialog.close();
            return;
          }

          for (const animation of dialog.getAnimations()) animation.finish();
          document.documentElement.setAttribute(returnAttribute, dialog.id);
          let transition: ViewTransition;
          try {
            transition = document.startViewTransition(() => {
              if (closeRequest === request && dialog.isConnected && dialog.open) dialog.close();
            });
          } catch {
            clearReturnMarker();
            dialog.close();
            return;
          }
          returnTransition = transition;
          activeReturnTransitions.add(transition);
          await Promise.allSettled([
            transition.updateCallbackDone,
            transition.ready,
            transition.finished,
          ]);
          activeReturnTransitions.delete(transition);
          if (returnTransition === transition) {
            returnTransition = undefined;
            if (closeRequest === request && dialog.isConnected && dialog.open) dialog.close();
            clearReturnMarker();
          }
          return;
        }

        dialog.dataset['closing'] = '';
        // cancellation (including reduced-motion changes) must still finish dismissal
        await Promise.allSettled(dialog.getAnimations().map((animation) => animation.finished));
        if (closeRequest === request && dialog.isConnected && dialog.open) dialog.close();
      };
      trigger.addEventListener('click', () => {
        if (dialog.open) return;
        returnTransition?.skipTransition();
        returnTransition = undefined;
        clearReturnMarker();
        closeRequest = undefined;
        delete dialog.dataset['closing'];
        dialog.showModal();
        body.scrollTop = 0;
      });
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        void requestClose();
      });
      dialog.querySelector('[data-dialog-close-form]')?.addEventListener('submit', (event) => {
        event.preventDefault();
        void requestClose();
      });
      dialog.addEventListener('close', () => {
        if (dialog.open) return;
        closeRequest = undefined;
        delete dialog.dataset['closing'];
      });
      if (dialog.hasAttribute('data-overlay-close-enabled')) {
        let didPressOverlay = false;
        /** Native backdrop events target the dialog, so exclude its panel bounds. */
        const isOverlayEvent = (event: MouseEvent): boolean => {
          if (event.target !== dialog) return false;
          const bounds = dialog.getBoundingClientRect();
          return (
            event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom
          );
        };
        dialog.addEventListener('pointerdown', (event) => {
          didPressOverlay = event.isPrimary && event.button === 0 && isOverlayEvent(event);
        });
        dialog.addEventListener('pointercancel', () => {
          didPressOverlay = false;
        });
        dialog.addEventListener('click', (event) => {
          const shouldClose = didPressOverlay && event.button === 0 && isOverlayEvent(event);
          didPressOverlay = false;
          if (shouldClose) void requestClose();
        });
        dialog.addEventListener('close', () => {
          didPressOverlay = false;
        });
      }
      root.dataset['enhanced'] = 'true';
      if (dialog.hasAttribute('data-dialog-fallback-open')) {
        dialog.close();
        dialog.removeAttribute('data-dialog-fallback-open');
      }
      trigger.hidden = false;
    }
  };

  initializeDialogs();
  document.addEventListener('astro:page-load', initializeDialogs);
  document.addEventListener('astro:before-swap', () => {
    for (const transition of activeReturnTransitions) transition.skipTransition();
    activeReturnTransitions.clear();
    document.documentElement.removeAttribute(returnAttribute);
    for (const dialog of document.querySelectorAll<HTMLDialogElement>(
      '[data-website-ui-dialog]:modal',
    )) {
      dialog.close();
    }
  });
</script>

<style>
  /* Native modality makes the page inert; also prevent background scrolling. */
  :global(html:has([data-website-ui-dialog]:modal)) {
    overflow: hidden;
  }

  /* Match platform dialog motion without animating content dimensions. */
  @media (prefers-reduced-motion: no-preference) {
    dialog:modal {
      animation: dialog-enter 300ms ease-out both;
    }

    dialog:modal::backdrop {
      animation: dialog-backdrop-enter 300ms ease-out both;
    }

    dialog[data-closing]:modal {
      animation: dialog-exit var(--dialog-exit-duration) ease-in both;
    }

    dialog[data-closing]:modal::backdrop {
      animation: dialog-backdrop-exit 200ms ease-in both;
    }
  }

  @media (max-width: 639px) and (prefers-reduced-motion: no-preference) {
    dialog:modal {
      animation: dialog-page-enter 300ms ease-out both;
    }

    dialog:modal::backdrop {
      animation: none;
    }
  }

  @keyframes dialog-page-enter {
    from {
      transform: scale(0.96);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes dialog-enter {
    from {
      opacity: 0;
      transform: var(--dialog-motion-transform);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes dialog-exit {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: var(--dialog-motion-transform);
    }
  }

  @keyframes dialog-backdrop-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dialog-backdrop-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
