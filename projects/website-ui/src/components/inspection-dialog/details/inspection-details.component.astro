---
import { ChevronDown, CircleCheck, Lightbulb } from '@lucide/astro';
import type { IInspectionFindingView } from '@moldea.ai/website-ui/inspection-presentation';
import CodeBlock from '../../code-block/code-block.component.astro';
import IconTile from '../../icon-tile/icon-tile.component.astro';
import InspectionLead from '../../inspection-finding/lead/inspection-lead.component.astro';
import InspectionMetadata from '../../inspection-finding/metadata/inspection-metadata.component.astro';
import InspectionSource from '../source/inspection-source.component.astro';

interface Props {
  finding: IInspectionFindingView;
}
const { finding } = Astro.props;
const affected = [finding.target, finding.related].filter((item) => item !== undefined);
---

<div
  class="grid min-w-0 gap-6"
  data-inspection-explanation
>
  <InspectionLead {finding} />
  {
    affected.length > 0 && (
      <section
        aria-label="Affected declaration"
        class="grid min-w-0 gap-3"
      >
        <>
          <InspectionMetadata
            items={affected}
            stacked
          />
        </>
      </section>
    )
  }
  {finding.declaration && <InspectionSource evidence={finding.declaration} />}
  {finding.evidence.map((evidence) => <InspectionSource {evidence} />)}
  {
    finding.kind === 'structural' &&
      (finding.severity === 'warning' && finding.accepted ? (
        <section
          class="flex min-w-0 items-start gap-3 rounded-xl border border-success/25 bg-success/5 p-4 dark:border-success/30 dark:bg-success/10"
          aria-label="Accepted in moldea.yaml"
        >
          <>
            <IconTile
              tone="success"
              size="sm"
            >
              <CircleCheck />
            </IconTile>
            <div class="min-w-0 text-sm leading-6">
              <h3 class="font-semibold">
                Accepted in <code class="inline-code font-normal">moldea.yaml</code>
              </h3>
              {finding.reason && <p class="mt-1 wrap-anywhere">{finding.reason}</p>}
              <p class="mt-2 text-xs leading-5 text-muted-foreground">
                To unaccept this warning, remove its{' '}
                <code class="inline-code font-normal">acceptedWarnings</code> entry.
              </p>
            </div>
          </>
        </section>
      ) : (
        <section
          class="flex min-w-0 items-start gap-3 rounded-xl border border-success/25 bg-success/5 p-4 dark:border-success/30 dark:bg-success/10"
          aria-label="How to fix"
        >
          <>
            <IconTile
              tone="success"
              size="sm"
            >
              <Lightbulb />
            </IconTile>
            <div class="min-w-0 text-sm leading-6">
              <>
                <h3 class="font-semibold">How to fix</h3>
                <p class="mt-1">
                  <a
                    class="inline-block text-link pointer-coarse:min-h-11"
                    href={finding.guidanceHref}
                  >
                    See the Core diagnostics guidance for this finding.
                  </a>
                </p>
              </>
            </div>
          </>
        </section>
      ))
  }
  {
    finding.kind === 'structural' && finding.acceptance && !finding.accepted && (
      <details class="group min-w-0 border-t pt-4">
        <>
          <summary class="flex w-fit max-w-full cursor-pointer list-none items-center gap-1.5 rounded-sm py-1 text-xs font-medium outline-none focus-visible:ring-2 focus-visible:ring-ring pointer-coarse:min-h-11 pointer-coarse:min-w-11 [&::-webkit-details-marker]:hidden">
            <ChevronDown
              class="size-3.5 shrink-0 group-open:rotate-180"
              aria-hidden="true"
            />
            <span>
              Accept this warning in <code class="inline-code font-normal">moldea.yaml</code>
            </span>
          </summary>
          <p class="mt-2 text-xs leading-5 text-muted-foreground">
            Fix the cause, or add this entry to{' '}
            <code class="inline-code font-normal">acceptedWarnings</code> with a reason.
          </p>
          <div class="mt-3">
            <CodeBlock
              source={finding.acceptance}
              language="yaml"
              ariaLabel="Warning acceptance"
            />
          </div>
        </>
      </details>
    )
  }
</div>
