---
import type { IInspectionResultView } from '@moldea.ai/website-ui/inspection-presentation';

import CodeBlock from '../../code-block/code-block.component.astro';

interface Props {
  result: IInspectionResultView;
}
const { result } = Astro.props;
---

{
  result.output !== undefined && (
    <div
      class="grid min-w-0 gap-4"
      data-inspection-output
    >
      {result.redactions.length > 0 && (
        <div class="text-xs leading-5 text-muted-foreground">
          <p class="font-semibold">Redacted fields</p>
          <ul class="mt-1 list-disc pl-4">
            {result.redactions.map((redaction) => (
              <li>{redaction}</li>
            ))}
          </ul>
        </div>
      )}
      <CodeBlock
        source={result.output}
        language="json"
        overflow="scroll"
        ariaLabel={result.outputLabel}
        headerLabel={result.command ?? result.outputLabel}
      >
        {result.exitStatus !== undefined && (
          <span
            slot="header-end"
            class="shrink-0 text-xs text-muted-foreground"
          >
            Exit {result.exitStatus}
          </span>
        )}
      </CodeBlock>
      {result.limitation && (
        <p class="text-xs leading-6 text-muted-foreground">{result.limitation}</p>
      )}
    </div>
  )
}
