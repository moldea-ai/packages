---
import type { IInspectionResultView } from '@moldea.ai/website-ui/inspection-presentation';

import Dialog from '../dialog/dialog.component.astro';
import TabbedPanels from '../tabbed-panels/tabbed-panels.component.astro';

import InspectionDetails from './details/inspection-details.component.astro';
import InspectionOutput from './output/inspection-output.component.astro';

// one result owns its complete output and the selectable evidence for its findings
export interface Props {
  id: string;
  result: IInspectionResultView;
  triggerLabel?: string;
  triggerAriaLabel?: string;
  triggerClass?: string;
}
const { id, result, triggerLabel, triggerAriaLabel, triggerClass } = Astro.props;
const tabsId = `${id}-tabs`;
const items = [
  {
    id: 'finding',
    label: result.findings.length > 1 ? 'Findings' : 'Finding',
    slotName: 'finding',
  },
  { id: 'output', label: 'Output', slotName: 'output' },
];
---

<div data-inspection-dialog-root>
  <Dialog
    id={id}
    title={result.title}
    triggerLabel={triggerLabel ?? 'View output'}
    triggerAriaLabel={triggerAriaLabel}
    triggerClass={triggerLabel === undefined ? 'hidden' : triggerClass}
    triggerSize={triggerLabel === undefined ? 'sm' : 'md'}
    fallbackOpen
    isOverlayCloseEnabled
  >
    <Fragment slot="trigger"><slot name="trigger">{triggerLabel ?? 'View output'}</slot></Fragment>
    <h2
      slot="heading"
      id={`${id}-title`}
      class="min-w-0 text-lg leading-6 font-semibold"
    >
      {result.title}
    </h2>
    {
      result.findings.length === 0 ? (
        <InspectionOutput result={result} />
      ) : result.output === undefined ? (
        <>
          <InspectionDetails
            id={id}
            resultTitle={result.title}
            findings={result.findings}
          />
          {result.limitation && (
            <p class="mt-4 text-xs leading-6 text-muted-foreground">{result.limitation}</p>
          )}
        </>
      ) : (
        <TabbedPanels
          id={tabsId}
          ariaLabel="Inspection details"
          items={items}
        >
          <InspectionDetails
            slot="finding"
            id={id}
            resultTitle={result.title}
            findings={result.findings}
          />
          <Fragment slot="output">
            <InspectionOutput result={result} />
          </Fragment>
        </TabbedPanels>
      )
    }
  </Dialog>
</div>

<script>
  /** Selects the overview or one finding without opening another modal or changing output. */
  const selectInspection = (
    dialog: HTMLDialogElement,
    selectedId?: string,
    shouldFocus = false,
  ): void => {
    const root = dialog.closest<HTMLElement>('[data-inspection-dialog-root]');
    if (root === null) return;
    const details = [...dialog.querySelectorAll<HTMLElement>('[data-inspection-detail]')];
    const selected = details.find((detail) => detail.dataset['inspectionDetail'] === selectedId);
    const overview = dialog.querySelector<HTMLElement>('[data-inspection-overview]');
    const active = selected ?? (overview === null ? details[0] : undefined);
    for (const detail of details) detail.hidden = detail !== active;
    if (overview !== null) overview.hidden = active !== undefined;
    const back = dialog.querySelector<HTMLElement>('[data-inspection-back]');
    if (back !== null) back.hidden = active === undefined;
    document.getElementById(`${dialog.id}-tabs`)?.dispatchEvent(
      new CustomEvent('website-ui:select-tab', {
        detail: { id: details.length === 0 ? 'output' : 'finding' },
      }),
    );
    if (shouldFocus) {
      const body = dialog.querySelector<HTMLElement>(':scope > div');
      if (body !== null) body.scrollTop = 0;
      active?.focus({ preventScroll: true });
    }
  };

  const initializeInspectionDialogs = (): void => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-inspection-dialog-root]')) {
      if (root.dataset['inspectionEnhanced'] === 'true') continue;
      const dialog = root.querySelector('dialog');
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function')
        continue;
      selectInspection(dialog);
      root.addEventListener(
        'click',
        (event) => {
          if (
            !(event instanceof MouseEvent) ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            !(event.target instanceof Element)
          )
            return;
          if (event.target.closest('[data-dialog-trigger]') !== null) {
            selectInspection(dialog);
            return;
          }
          const row = event.target.closest<HTMLElement>('[data-inspection-show]');
          if (row !== null) {
            event.preventDefault();
            selectInspection(dialog, row.dataset['inspectionShow'], true);
            return;
          }
          if (event.target.closest('[data-inspection-back] a') !== null) {
            event.preventDefault();
            const activeId = dialog.querySelector<HTMLElement>(
              '[data-inspection-detail]:not([hidden])',
            )?.dataset['inspectionDetail'];
            selectInspection(dialog);
            const rows = dialog.querySelectorAll<HTMLElement>('[data-inspection-show]');
            [...rows].find((item) => item.dataset['inspectionShow'] === activeId)?.focus();
          }
        },
        { capture: true },
      );
      root.dataset['inspectionEnhanced'] = 'true';
    }
  };
  document.addEventListener(
    'click',
    (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !(event.target instanceof Element)
      )
        return;
      const opener = event.target.closest<HTMLElement>('[data-inspection-select]');
      const id = opener?.dataset['dialogOpen'];
      if (opener === null || opener === undefined || id === undefined) return;
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement)
        selectInspection(dialog, opener.dataset['inspectionSelect']);
    },
    { capture: true },
  );
  initializeInspectionDialogs();
  document.addEventListener('astro:page-load', initializeInspectionDialogs);
</script>
