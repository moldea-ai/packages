---
import { CircleAlert } from '@lucide/astro';
import {
  DIAGNOSTIC_GROUP_PRESENTATIONS,
  INSPECTION_SEVERITY_PRESENTATIONS,
  type IInspectionResultView,
} from '@moldea.ai/website-ui/inspection-presentation';

import CodeBlock from '../code-block/code-block.component.astro';
import Dialog from '../dialog/dialog.component.astro';
import FilePreview from '../file-preview/file-preview.component.astro';
import TabbedPanels from '../tabbed-panels/tabbed-panels.component.astro';

import InspectionOutput from './output/inspection-output.component.astro';

// one result owns its complete output and the selectable evidence for its findings
export interface Props {
  id: string;
  result: IInspectionResultView;
}
const { id, result } = Astro.props;
const tabsId = `${id}-tabs`;
const items = [
  { id: 'finding', label: 'Finding', slotName: 'finding' },
  { id: 'output', label: 'Output', slotName: 'output' },
];
---

<div data-inspection-dialog-root>
  <Dialog
    id={id}
    title={result.title}
    triggerLabel="View output"
    triggerClass="hidden"
    fallbackOpen
    isOverlayCloseEnabled
  >
    <h2
      slot="heading"
      id={`${id}-title`}
      class="min-w-0 text-lg leading-6 font-semibold"
    >
      {result.title}
    </h2>
    {
      result.findings.length === 0 ? (
        <InspectionOutput result={result} />
      ) : (
        <TabbedPanels
          id={tabsId}
          ariaLabel="Inspection details"
          items={items}
        >
          <div
            slot="finding"
            class="min-w-0"
          >
            {result.findings.map((finding) => {
              const severity = INSPECTION_SEVERITY_PRESENTATIONS[finding.severity];
              const SeverityIcon = severity.icon;
              const group = DIAGNOSTIC_GROUP_PRESENTATIONS[finding.group];
              const GroupIcon = group.icon;
              return (
                <section
                  id={`${id}-finding-${finding.id}`}
                  data-inspection-detail={finding.id}
                  class="grid min-w-0 gap-4"
                >
                  <div
                    class="min-w-0 overflow-hidden rounded-xl border bg-card"
                    data-inspection-finding-card
                  >
                    <div class="flex flex-wrap items-center gap-3 border-b p-4">
                      <span
                        class:list={[
                          'flex size-9 shrink-0 items-center justify-center rounded-lg',
                          finding.accepted
                            ? 'bg-info/10 text-info-foreground dark:text-info'
                            : finding.severity === 'error'
                              ? 'bg-destructive/10 text-destructive'
                              : 'bg-warning/10 text-warning-foreground dark:text-warning',
                        ]}
                      >
                        <GroupIcon
                          class="size-4"
                          aria-hidden="true"
                        />
                      </span>
                      <div class="min-w-0 flex-1 text-sm font-semibold">{group.label}</div>
                      <span
                        class:list={[
                          'inline-flex shrink-0 items-center gap-1 text-xs font-semibold',
                          finding.accepted
                            ? 'text-info-foreground dark:text-info'
                            : finding.severity === 'error'
                              ? 'text-destructive'
                              : 'text-warning-foreground dark:text-warning',
                        ]}
                      >
                        <SeverityIcon
                          class="size-3.5"
                          aria-hidden="true"
                        />
                        {finding.accepted ? 'Accepted warning' : severity.label}
                      </span>
                    </div>
                    <div class="grid min-w-0 gap-3 p-3 sm:p-4">
                      {finding.title !== result.title && (
                        <h3 class="text-base leading-6 font-semibold">{finding.title}</h3>
                      )}
                      {finding.message !== finding.title && (
                        <p class="text-sm leading-6">{finding.message}</p>
                      )}
                      {finding.reason && (
                        <p class="border-l-2 border-info/40 pl-3 text-sm leading-6">
                          {finding.reason}
                        </p>
                      )}
                      <dl class="grid min-w-0 gap-2 border-t pt-3 text-xs leading-5">
                        <div class="grid min-w-0 gap-1 sm:grid-cols-[4rem_minmax(0,1fr)]">
                          <dt class="text-muted-foreground">Code</dt>
                          <dd class="min-w-0">
                            <code class="break-all">{finding.code}</code>
                          </dd>
                        </div>
                        {finding.path && (
                          <div class="grid min-w-0 gap-1 sm:grid-cols-[4rem_minmax(0,1fr)]">
                            <dt class="text-muted-foreground">Location</dt>
                            <dd class="min-w-0">
                              <code class="break-all">{finding.path}</code>
                              {finding.pointer && (
                                <code class="mt-1 block break-all text-muted-foreground">
                                  {finding.pointer}
                                </code>
                              )}
                            </dd>
                          </div>
                        )}
                      </dl>
                    </div>
                  </div>
                  {finding.evidence.map((evidence) => (
                    <FilePreview
                      path={evidence.path}
                      label={
                        evidence.isMissing
                          ? 'Missing target'
                          : evidence.isExcerpt
                            ? `${evidence.label ?? 'Source'} excerpt`
                            : (evidence.label ??
                              (evidence.path === finding.path ? 'Reported in' : 'Related file'))
                      }
                    >
                      {evidence.isMissing && (
                        <CircleAlert
                          slot="icon"
                          class="size-5 text-destructive"
                        />
                      )}
                      {evidence.isMissing && (
                        <span
                          slot="status"
                          class="text-xs font-semibold text-destructive"
                        >
                          Missing
                        </span>
                      )}
                      {evidence.content !== undefined && (
                        <div class="p-3">
                          <CodeBlock
                            source={evidence.content}
                            language={evidence.language}
                            variant="plain"
                            copyable={!evidence.isExcerpt}
                            ariaLabel={evidence.path}
                          />
                        </div>
                      )}
                    </FilePreview>
                  ))}
                </section>
              );
            })}
          </div>
          <Fragment slot="output">
            <InspectionOutput result={result} />
          </Fragment>
        </TabbedPanels>
      )
    }
  </Dialog>
</div>

<script>
  /** Selects result-owned evidence before the shared Dialog opens its native modal. */
  const selectInspection = (dialog: HTMLDialogElement, selectedId?: string): void => {
    const root = dialog.closest<HTMLElement>('[data-inspection-dialog-root]');
    if (root === null) return;
    const details = [...dialog.querySelectorAll<HTMLElement>('[data-inspection-detail]')];
    const selected = details.find((detail) => detail.dataset['inspectionDetail'] === selectedId);
    for (const detail of details) detail.hidden = detail !== (selected ?? details[0]);
    document.getElementById(`${dialog.id}-tabs`)?.dispatchEvent(
      new CustomEvent('website-ui:select-tab', {
        detail: { id: selected === undefined ? 'output' : 'finding' },
      }),
    );
  };

  const initializeInspectionDialogs = (): void => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-inspection-dialog-root]')) {
      if (root.dataset['inspectionEnhanced'] === 'true') continue;
      const dialog = root.querySelector('dialog');
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function')
        continue;
      const first = dialog.querySelector<HTMLElement>('[data-inspection-detail]');
      selectInspection(dialog, first?.dataset['inspectionDetail']);
      root.dataset['inspectionEnhanced'] = 'true';
    }
  };
  document.addEventListener(
    'click',
    (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !(event.target instanceof Element)
      )
        return;
      const opener = event.target.closest<HTMLElement>('[data-inspection-select]');
      const id = opener?.dataset['dialogOpen'];
      if (opener === null || opener === undefined || id === undefined) return;
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement)
        selectInspection(dialog, opener.dataset['inspectionSelect']);
    },
    { capture: true },
  );
  initializeInspectionDialogs();
  document.addEventListener('astro:page-load', initializeInspectionDialogs);
</script>
