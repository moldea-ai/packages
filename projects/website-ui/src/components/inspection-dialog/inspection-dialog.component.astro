---
import type { IInspectionResultView } from '@moldea.ai/website-ui/inspection-presentation';

import Dialog from '../dialog/dialog.component.astro';
import TabbedPanels from '../tabbed-panels/tabbed-panels.component.astro';

import InspectionDetails from './details/inspection-details.component.astro';
import InspectionOutput from './output/inspection-output.component.astro';

// one result owns its complete output and the selectable evidence for its findings
export interface Props {
  id: string;
  result: IInspectionResultView;
}
const { id, result } = Astro.props;
const tabsId = `${id}-tabs`;
const items = [
  { id: 'finding', label: 'Finding', slotName: 'finding' },
  { id: 'output', label: 'Output', slotName: 'output' },
];
---

<div data-inspection-dialog-root>
  <Dialog
    id={id}
    title={result.title}
    triggerLabel="View output"
    triggerClass="hidden"
    fallbackOpen
    isOverlayCloseEnabled
  >
    <h2
      slot="heading"
      id={`${id}-title`}
      class="min-w-0 text-lg leading-6 font-semibold"
    >
      {result.title}
    </h2>
    {
      result.findings.length === 0 ? (
        <InspectionOutput result={result} />
      ) : result.output === undefined ? (
        <>
          <InspectionDetails
            id={id}
            resultTitle={result.title}
            findings={result.findings}
          />
          {result.limitation && (
            <p class="mt-4 text-xs leading-6 text-muted-foreground">{result.limitation}</p>
          )}
        </>
      ) : (
        <TabbedPanels
          id={tabsId}
          ariaLabel="Inspection details"
          items={items}
        >
          <InspectionDetails
            slot="finding"
            id={id}
            resultTitle={result.title}
            findings={result.findings}
          />
          <Fragment slot="output">
            <InspectionOutput result={result} />
          </Fragment>
        </TabbedPanels>
      )
    }
  </Dialog>
</div>

<script>
  /** Selects result-owned evidence before the shared Dialog opens its native modal. */
  const selectInspection = (dialog: HTMLDialogElement, selectedId?: string): void => {
    const root = dialog.closest<HTMLElement>('[data-inspection-dialog-root]');
    if (root === null) return;
    const details = [...dialog.querySelectorAll<HTMLElement>('[data-inspection-detail]')];
    const selected = details.find((detail) => detail.dataset['inspectionDetail'] === selectedId);
    for (const detail of details) detail.hidden = detail !== (selected ?? details[0]);
    document.getElementById(`${dialog.id}-tabs`)?.dispatchEvent(
      new CustomEvent('website-ui:select-tab', {
        detail: { id: selected === undefined ? 'output' : 'finding' },
      }),
    );
  };

  const initializeInspectionDialogs = (): void => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-inspection-dialog-root]')) {
      if (root.dataset['inspectionEnhanced'] === 'true') continue;
      const dialog = root.querySelector('dialog');
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function')
        continue;
      const first = dialog.querySelector<HTMLElement>('[data-inspection-detail]');
      selectInspection(dialog, first?.dataset['inspectionDetail']);
      root.dataset['inspectionEnhanced'] = 'true';
    }
  };
  document.addEventListener(
    'click',
    (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !(event.target instanceof Element)
      )
        return;
      const opener = event.target.closest<HTMLElement>('[data-inspection-select]');
      const id = opener?.dataset['dialogOpen'];
      if (opener === null || opener === undefined || id === undefined) return;
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement)
        selectInspection(dialog, opener.dataset['inspectionSelect']);
    },
    { capture: true },
  );
  initializeInspectionDialogs();
  document.addEventListener('astro:page-load', initializeInspectionDialogs);
</script>
