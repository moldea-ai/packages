---
import { ListTree } from '@lucide/astro';
import type { IInspectionFindingView } from '@moldea.ai/website-ui/inspection-presentation';
import ActionButton from '../action-button/action-button.component.astro';
import Dialog from '../dialog/dialog.component.astro';
import InspectionDetails from './details/inspection-details.component.astro';
import InspectionEvaluation from './evaluation/inspection-evaluation.component.astro';

// the secondary modal is a sibling, so both reuse the existing dialog lifecycle unchanged
export interface Props {
  id: string;
  finding: IInspectionFindingView;
}
const { id, finding } = Astro.props;
const title = finding.kind === 'structural' ? 'Structural finding' : 'Behavior finding';
const evaluationId = `${id}-evaluation`;
---

<div data-inspection-dialog-root>
  <Dialog
    {id}
    {title}
    panelClass="max-sm:[&>header]:pr-[max(1rem,env(safe-area-inset-right))] max-sm:[&>header]:pl-[max(1rem,env(safe-area-inset-left))] max-sm:pointer-coarse:[&>header]:pl-[max(0.5rem,env(safe-area-inset-left))]"
    triggerLabel="Open finding"
    triggerClass="hidden"
    fallbackOpen
    isOverlayCloseEnabled
  >
    <div
      slot="heading"
      class="flex w-full min-w-0 items-center justify-between gap-3"
    >
      <h2
        id={`${id}-title`}
        class="min-w-0 truncate text-lg font-semibold"
      >
        {title}
      </h2>
      {
        finding.kind === 'structural' && (
          <ActionButton
            variant="ghost"
            size="icon-xs"
            class="hidden shrink-0 max-sm:min-h-11 max-sm:min-w-11 pointer-coarse:min-h-11 pointer-coarse:min-w-11 [[data-dialog-root][data-enhanced=true]_&]:inline-flex"
            aria-label="Evaluation details"
            title="Evaluation details"
            data-dialog-open={evaluationId}
            aria-controls={evaluationId}
            aria-haspopup="dialog"
          >
            <ListTree
              class="size-4"
              aria-hidden="true"
            />
          </ActionButton>
        )
      }
    </div>
    <InspectionDetails {finding} />
  </Dialog>
  {
    finding.kind === 'structural' && (
      <Dialog
        id={evaluationId}
        title="Evaluation details"
        panelClass="max-sm:[&>header]:pr-[max(1rem,env(safe-area-inset-right))] max-sm:[&>header]:pl-[max(1rem,env(safe-area-inset-left))] max-sm:pointer-coarse:[&>header]:pl-[max(0.5rem,env(safe-area-inset-left))]"
        triggerLabel="Evaluation details"
        triggerClass="hidden"
        fallbackOpen
        isOverlayCloseEnabled
      >
        <InspectionEvaluation {finding} />
      </Dialog>
    )
  }
</div>
