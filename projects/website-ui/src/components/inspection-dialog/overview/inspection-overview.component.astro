---
import { ChevronRight } from '@lucide/astro';
import {
  DIAGNOSTIC_GROUP_PRESENTATIONS,
  FINDING_CATEGORY_PRESENTATIONS,
  INSPECTION_SEVERITY_PRESENTATIONS,
  type IInspectionFindingView,
} from '@moldea.ai/website-ui/inspection-presentation';

import ActionLink from '../../action-link/action-link.component.astro';
import IconTile from '../../icon-tile/icon-tile.component.astro';

interface Props {
  id: string;
  findings: IInspectionFindingView[];
}
const { id, findings } = Astro.props;
const priority = (finding: IInspectionFindingView): number =>
  finding.severity === 'error' ? 0 : finding.accepted ? 2 : 1;
const ordered = findings.toSorted((left, right) => priority(left) - priority(right));
---

<div
  id={`${id}-findings`}
  data-inspection-overview
>
  <ul
    aria-label="Inspection findings"
    class="grid min-w-0 divide-y rounded-xl border"
  >
    {
      ordered.map((finding) => {
        const subject =
          finding.category === undefined
            ? DIAGNOSTIC_GROUP_PRESENTATIONS[finding.group]
            : FINDING_CATEGORY_PRESENTATIONS[finding.category];
        const Icon = subject.icon;
        const status = finding.accepted
          ? 'Accepted'
          : INSPECTION_SEVERITY_PRESENTATIONS[finding.severity].label;
        return (
          <li class="min-w-0">
            <ActionLink
              href={`#${id}-finding-${finding.id}`}
              data-inspection-show={finding.id}
              aria-controls={`${id}-finding-${finding.id}`}
              aria-label={`View finding: ${finding.title} ${finding.code}`}
              aria-describedby={`${id}-summary-${finding.id}${finding.path ? ` ${id}-path-${finding.id}` : ''}`}
              variant="ghost"
              size="sm"
              class="h-auto w-full min-w-0 items-start justify-start gap-3 rounded-lg p-3 text-start text-foreground motion-reduce:transition-none sm:p-5"
            >
              <IconTile
                tone={
                  finding.accepted ? 'info' : finding.severity === 'error' ? 'danger' : 'warning'
                }
              >
                <Icon />
              </IconTile>
              <span class="grid min-w-0 flex-1 gap-2">
                <span
                  id={`${id}-summary-${finding.id}`}
                  class="flex flex-wrap items-baseline gap-x-2 text-xs font-normal"
                >
                  <span class="font-medium">{status}</span>
                  <span class="text-muted-foreground">{subject.label}</span>
                </span>
                <span class="text-sm leading-5 font-medium wrap-anywhere whitespace-normal">
                  {finding.title}
                </span>
                <code
                  class="truncate font-mono text-[11px] font-normal text-muted-foreground"
                  title={finding.code}
                >
                  {finding.code}
                </code>
                {finding.path && (
                  <code
                    id={`${id}-path-${finding.id}`}
                    class="truncate font-mono text-[11px] font-normal text-muted-foreground"
                    title={finding.path}
                  >
                    {finding.path}
                  </code>
                )}
              </span>
              <ChevronRight
                class="size-4 shrink-0 text-muted-foreground"
                aria-hidden="true"
              />
            </ActionLink>
          </li>
        );
      })
    }
  </ul>
</div>
