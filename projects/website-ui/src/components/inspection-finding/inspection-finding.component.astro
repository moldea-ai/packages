---
import { ArrowUpRight } from '@lucide/astro';
import { formatRepositoryPath } from '@moldea.ai/website-ui/code-presentation';
import {
  getInspectionImpact,
  getInspectionPresentation,
  type IInspectionFindingView,
  type IInspectionMetadataItem,
} from '@moldea.ai/website-ui/inspection-presentation';
import IconTile from '../icon-tile/icon-tile.component.astro';
import InspectionBadge from './badge/inspection-badge.component.astro';
import InspectionMetadata from './metadata/inspection-metadata.component.astro';

// the whole card is one named trigger; metadata remains plain, tooltip-free code
export interface Props {
  finding: IInspectionFindingView;
  dialogId: string;
}
const { finding, dialogId } = Astro.props;
const subject = getInspectionPresentation(finding),
  impact = getInspectionImpact(finding);
const Icon = subject.icon;
const metadata: IInspectionMetadataItem[] = [
  { label: 'Code', value: finding.code, icon: 'code' },
  ...(finding.path && finding.target?.value !== formatRepositoryPath(finding.path)
    ? [{ label: 'Declared in', value: formatRepositoryPath(finding.path), icon: 'file' as const }]
    : []),
];
---

<article
  class:list={['relative min-w-0 overflow-hidden rounded-lg border p-4 sm:p-5', impact.card]}
  aria-label={finding.kind === 'structural' ? 'Structural finding' : 'Behavior finding'}
  data-inspection-finding
  data-finding-code={finding.code}
  data-finding-severity={finding.severity}
>
  <a
    href={`#${dialogId}`}
    data-dialog-open={dialogId}
    aria-controls={dialogId}
    aria-haspopup="dialog"
    aria-label={`View finding: ${finding.message}`}
    class:list={[
      'absolute inset-0 z-10 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-inset pointer-coarse:min-h-11 pointer-coarse:min-w-11',
      impact.trigger,
    ]}
    ><span class="sr-only">View finding: {finding.message}</span></a
  >
  <ArrowUpRight
    class="pointer-events-none absolute top-4 right-4 size-4 text-muted-foreground sm:top-5 sm:right-5"
    aria-hidden="true"
  />
  <div class="pointer-events-none relative min-w-0 pr-7">
    <div class="flex min-w-0 items-start gap-3">
      <IconTile tone={impact.tone}><Icon /></IconTile>
      <div class="min-w-0 flex-1">
        <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-2">
          <span class="text-xs text-muted-foreground">{subject.label}</span><InspectionBadge
            presentation={impact}
          />
        </div>
        <p class="mt-1.5 text-sm leading-snug font-semibold wrap-anywhere">{finding.message}</p>
      </div>
    </div>
    {
      (finding.target || finding.related) && (
        <div class="mt-3">
          <InspectionMetadata
            items={[finding.target, finding.related].filter((item) => item !== undefined)}
          />
        </div>
      )
    }
    <div class="mt-2"><InspectionMetadata items={metadata} /></div>
    {
      finding.severity === 'warning' && finding.accepted && finding.reason && (
        <p class="mt-3 text-xs leading-5 wrap-anywhere text-muted-foreground">
          <span class="font-medium text-foreground">Accepted in moldea.yaml</span> ·{' '}
          {finding.reason}
        </p>
      )
    }
  </div>
</article>
