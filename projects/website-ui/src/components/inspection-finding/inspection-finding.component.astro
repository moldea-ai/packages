---
import {
  INSPECTION_SEVERITY_PRESENTATIONS,
  type IInspectionPresentation,
  type IInspectionSeverity,
} from '@moldea.ai/website-ui/inspection-presentation';

import CodeText from '../code-text/code-text.component.astro';

// one finding keeps its subject, exact code, and severity visible together
interface Props {
  title: string;
  code: string;
  severity: IInspectionSeverity;
  presentation: IInspectionPresentation;
  path?: string;
  accepted?: boolean;
}
const { title, code, severity, presentation, path, accepted = false } = Astro.props;
const SubjectIcon = presentation.icon;
const status = INSPECTION_SEVERITY_PRESENTATIONS[severity];
const SeverityIcon = status.icon;
---

<article
  class="flex min-w-0 items-start gap-3"
  aria-label={`${title}: ${code}`}
  data-inspection-finding
  data-finding-code={code}
  data-finding-severity={severity}
>
  <span
    class:list={[
      'flex size-9 shrink-0 items-center justify-center rounded-lg',
      accepted
        ? 'bg-info/10 text-info-foreground dark:text-info'
        : severity === 'error'
          ? 'bg-destructive/10 text-destructive'
          : 'bg-warning/15 text-warning-foreground dark:text-warning',
    ]}
    aria-hidden="true"
    ><SubjectIcon class="size-5" /></span
  >
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-xs">
      <span class="font-medium text-muted-foreground">{presentation.label}</span>
      <span
        class:list={[
          'inline-flex items-center gap-1 font-semibold',
          accepted
            ? 'text-info-foreground dark:text-info'
            : severity === 'error'
              ? 'text-destructive'
              : 'text-warning-foreground dark:text-warning',
        ]}
      >
        <SeverityIcon
          class="size-3"
          aria-hidden="true"
        />
        {accepted ? 'Accepted' : status.label}
      </span>
    </div>
    <p class="mt-1 text-sm leading-5 font-semibold">{title}</p>
    <CodeText
      class="mt-1 block text-xs leading-5 text-muted-foreground"
      value={code}
    />
    {
      path && (
        <CodeText
          class="mt-1 block text-xs leading-5 text-muted-foreground"
          value={path}
        />
      )
    }
  </div>
  <slot name="action" />
</article>
