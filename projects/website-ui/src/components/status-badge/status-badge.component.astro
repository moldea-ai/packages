---
export type IStatusBadgeTone = 'danger' | 'info' | 'neutral' | 'success' | 'warning';

export interface Props {
  borderStyle?: 'dashed' | 'dotted' | 'solid';
  label: string;
  size?: 'md' | 'sm';
  tone: IStatusBadgeTone;
  truncate?: boolean;
}

const { borderStyle = 'solid', label, size = 'md', tone, truncate = false } = Astro.props;
const sizeClasses = {
  md: 'min-h-6 gap-1 px-2.5 py-1 text-xs font-medium [&_svg]:size-3',
  sm: 'min-h-5 gap-1 px-1.5 py-0 text-xs font-medium [&_svg]:size-3',
} as const;
const borderStyleClasses = {
  dashed: 'border-dashed',
  dotted: 'border-dotted',
  solid: 'border-solid',
} as const;
const toneClasses = {
  danger: 'border-destructive/40 bg-destructive/10 text-foreground',
  info: 'border-info/40 bg-info/10 text-foreground',
  neutral: 'border-border bg-muted text-muted-foreground',
  success: 'border-success/40 bg-success/10 text-success',
  warning: 'border-warning/60 bg-warning/15 text-warning-foreground dark:text-foreground',
} as const;
---

<span
  class:list={[
    'max-w-full rounded-full border text-start',
    truncate ? 'block min-w-0 truncate' : 'inline-flex shrink-0 items-center whitespace-nowrap',
    borderStyleClasses[borderStyle],
    sizeClasses[size],
    toneClasses[tone],
  ]}
  data-status-badge={tone}
>
  <slot name="icon" />
  {label}
</span>
