---
import { GitFork, Menu, Search } from '@lucide/astro';

import ThemeControl from '../theme-control/theme-control.component.astro';

export interface ISiteHeaderNavigationItem {
  href: string;
  isActive: boolean;
  label: string;
}

export interface Props {
  breakpoint?: 'lg' | 'md';
  mobileMenuLabel?: string;
  mobileNavigationAriaLabel?: string;
  navigationAriaLabel?: string;
  navigationItems: readonly ISiteHeaderNavigationItem[];
  searchAriaLabel: string;
  searchHref: string;
  searchIsActive: boolean;
  sourceAriaLabel: string;
  sourceHref: string;
  sourceLabel?: string;
  themeStorageKey: string;
}

const {
  breakpoint = 'md',
  mobileMenuLabel = 'Open navigation',
  mobileNavigationAriaLabel,
  navigationAriaLabel = 'Primary navigation',
  navigationItems,
  searchAriaLabel,
  searchHref,
  searchIsActive,
  sourceAriaLabel,
  sourceHref,
  sourceLabel = 'Source on GitHub',
  themeStorageKey,
} = Astro.props;
const breakpointClasses = {
  lg: {
    desktop: 'hidden lg:flex',
    mobile: 'lg:hidden',
  },
  md: {
    desktop: 'hidden md:flex',
    mobile: 'md:hidden',
  },
} as const;
const responsiveClasses = breakpointClasses[breakpoint];
---

<header class="sticky top-0 z-50 border-b border-border bg-background/92 backdrop-blur-xl">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <slot name="brand" />

    <nav
      class:list={['items-center gap-1', responsiveClasses.desktop]}
      aria-label={navigationAriaLabel}
    >
      {
        navigationItems.map(({ href, isActive, label }) => (
          <a
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors',
              isActive
                ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            href={href}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class:list={['items-center gap-2', responsiveClasses.desktop]}>
      <a
        class:list={[
          'inline-flex size-10 items-center justify-center rounded-lg transition-colors',
          searchIsActive ? 'bg-secondary/70 dark:bg-secondary/50' : 'hover:bg-muted',
        ]}
        href={searchHref}
        aria-label={searchAriaLabel}
        aria-current={searchIsActive ? 'page' : undefined}
      >
        <Search
          class="size-4"
          aria-hidden="true"
        />
      </a>
      <a
        class="inline-flex size-10 items-center justify-center rounded-lg hover:bg-muted"
        href={sourceHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={sourceAriaLabel}
      >
        <GitFork
          class="size-4"
          aria-hidden="true"
        />
      </a>
      <ThemeControl storageKey={themeStorageKey} />
      <slot name="desktop-actions" />
    </div>

    <details class:list={['group relative', responsiveClasses.mobile]}>
      <summary
        class="flex size-11 list-none items-center justify-center rounded-lg border border-input bg-background hover:bg-muted [&::-webkit-details-marker]:hidden"
        aria-label={mobileMenuLabel}
      >
        <Menu
          class="size-5"
          aria-hidden="true"
        />
      </summary>
      <div
        class="surface-card absolute end-0 top-13 w-[min(20rem,calc(100vw-2rem))] space-y-1 p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label={mobileNavigationAriaLabel ??
            `Mobile ${navigationAriaLabel.toLocaleLowerCase()}`}
        >
          {
            navigationItems.map(({ href, isActive, label }) => (
              <a
                class:list={[
                  'rounded-lg px-3 py-3 transition-colors',
                  isActive
                    ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                    : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
                ]}
                href={href}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
          <a
            class:list={[
              'rounded-lg px-3 py-3 transition-colors',
              searchIsActive
                ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            href={searchHref}
            aria-current={searchIsActive ? 'page' : undefined}
          >
            Search
          </a>
          <a
            class="rounded-lg px-3 py-3 font-semibold hover:bg-muted"
            href={sourceHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {sourceLabel}
          </a>
          <slot name="mobile-actions" />
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl storageKey={themeStorageKey} />
        </div>
      </div>
    </details>
  </div>
</header>
