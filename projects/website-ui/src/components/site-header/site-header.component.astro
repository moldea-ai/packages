---
import { ExternalLink, GitBranch, Menu, Search } from '@lucide/astro';

import ActionLink from '../action-link/action-link.component.astro';
import InlineBrandText from '../inline-brand-text/inline-brand-text.component.astro';
import ThemeControl from '../theme-control/theme-control.component.astro';

export interface ISiteHeaderNavigationItem {
  compactLabel?: string;
  href: string;
  isActive: boolean;
  label: string;
}

export interface Props {
  breakpoint?: 'lg' | 'md';
  mobileMenuLabel?: string;
  mobileNavigationAriaLabel?: string;
  navigationAriaLabel?: string;
  navigationItems: readonly ISiteHeaderNavigationItem[];
  searchAriaLabel: string;
  searchHref: string;
  searchIsActive: boolean;
  sourceAriaLabel: string;
  sourceHref: string;
  sourceLabel?: string;
  themeStorageKey: string;
}

const {
  breakpoint = 'md',
  mobileMenuLabel = 'Open navigation',
  mobileNavigationAriaLabel,
  navigationAriaLabel = 'Primary navigation',
  navigationItems,
  searchAriaLabel,
  searchHref,
  searchIsActive,
  sourceAriaLabel,
  sourceHref,
  sourceLabel = 'Source on GitHub',
  themeStorageKey,
} = Astro.props;
const breakpointClasses = {
  lg: {
    desktop: 'hidden lg:flex',
    mobile: 'lg:hidden',
  },
  md: {
    desktop: 'hidden md:flex',
    mobile: 'md:hidden',
  },
} as const;
const responsiveClasses = breakpointClasses[breakpoint];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/85"
>
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <slot name="brand" />

    <nav
      class:list={['items-center gap-1', responsiveClasses.desktop]}
      aria-label={navigationAriaLabel}
    >
      {
        navigationItems.map(({ href, isActive, label, compactLabel }) => (
          <a
            class="rounded-lg navigation-link px-3 py-2 text-sm whitespace-nowrap"
            href={href}
            aria-label={compactLabel ? label : undefined}
            aria-current={isActive ? 'page' : undefined}
          >
            {compactLabel ? (
              <>
                <span
                  class="xl:hidden"
                  aria-hidden="true"
                >
                  <InlineBrandText
                    text={compactLabel}
                    variant="compact"
                  />
                </span>
                <span
                  class="hidden xl:inline"
                  aria-hidden="true"
                >
                  <InlineBrandText
                    text={label}
                    variant="compact"
                  />
                </span>
              </>
            ) : (
              <InlineBrandText
                text={label}
                variant="compact"
              />
            )}
          </a>
        ))
      }
    </nav>

    <div class:list={['items-center gap-2', responsiveClasses.desktop]}>
      <ActionLink
        size="icon"
        variant="ghost"
        class="aria-[current=page]:bg-secondary"
        href={searchHref}
        aria-label={searchAriaLabel}
        aria-current={searchIsActive ? 'page' : undefined}
      >
        <Search
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        size="icon"
        variant="ghost"
        href={sourceHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={sourceAriaLabel}
      >
        <GitBranch
          class="size-4"
          aria-hidden="true"
          data-external-link-icon
        />
      </ActionLink>
      <ThemeControl storageKey={themeStorageKey} />
      <slot name="desktop-actions" />
    </div>

    <details class:list={['group relative', responsiveClasses.mobile]}>
      <summary
        class="flex size-11 list-none items-center justify-center rounded-lg border border-input surface-link bg-background [&::-webkit-details-marker]:hidden"
        aria-label={mobileMenuLabel}
      >
        <Menu
          class="size-5"
          aria-hidden="true"
        />
      </summary>
      <div
        class="surface-card absolute end-0 top-13 w-[min(20rem,calc(100vw-2rem))] space-y-1 p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label={mobileNavigationAriaLabel ??
            `Mobile ${navigationAriaLabel.toLocaleLowerCase()}`}
        >
          {
            navigationItems.map(({ href, isActive, label }) => (
              <a
                class="rounded-lg navigation-link px-3 py-3"
                href={href}
                aria-current={isActive ? 'page' : undefined}
              >
                <InlineBrandText
                  text={label}
                  variant="compact"
                />
              </a>
            ))
          }
          <a
            class="rounded-lg navigation-link px-3 py-3"
            href={searchHref}
            aria-current={searchIsActive ? 'page' : undefined}
          >
            Search
          </a>
          <a
            class="rounded-lg navigation-link px-3 py-3"
            href={sourceHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <InlineBrandText
              text={sourceLabel}
              variant="compact"
            />
            <ExternalLink
              class="ms-1.5 inline size-3.5"
              aria-hidden="true"
              data-external-link-icon
            />
          </a>
          <slot name="mobile-actions" />
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl storageKey={themeStorageKey} />
        </div>
      </div>
    </details>
  </div>
</header>
