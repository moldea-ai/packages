---
import { ExternalLink } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  class?: string;
  size?: 'icon' | 'lg' | 'md' | 'sm';
  variant?: 'ghost' | 'link' | 'outline' | 'primary' | 'secondary';
}

const {
  class: className,
  size = 'md',
  variant = 'primary',
  target,
  rel,
  ...attributes
} = Astro.props;
const relationship =
  target === '_blank'
    ? [...new Set([...(rel?.split(/\s+/u) ?? []), 'noopener', 'noreferrer'])]
        .filter(Boolean)
        .join(' ')
    : rel;
---

<a
  class:list={[
    'action-control',
    variant === 'link' ? 'text-action-link' : `action-${variant}`,
    `action-size-${size}`,
    className,
  ]}
  {...attributes}
  {target}
  rel={relationship}
>
  <slot />
  {
    target === '_blank' && (
      <ExternalLink
        class="size-4 shrink-0"
        aria-hidden="true"
        data-external-link-icon
      />
    )
  }
</a>
