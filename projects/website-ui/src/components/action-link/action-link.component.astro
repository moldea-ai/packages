---
import { ExternalLink } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  class?: string;
  size?: 'icon' | 'lg' | 'md' | 'sm';
  variant?: 'ghost' | 'link' | 'outline' | 'primary' | 'secondary';
}

const {
  class: className,
  size = 'md',
  variant = 'primary',
  target,
  rel,
  'aria-label': ariaLabel,
  ...attributes
} = Astro.props;
const isNewTab = target === '_blank';
const relationship = isNewTab
  ? [...new Set([...(rel?.split(/\s+/u) ?? []), 'noopener', 'noreferrer'])]
      .filter(Boolean)
      .join(' ')
  : rel;
// an explicit accessible name replaces the link text, so the new-tab notice joins that name
const accessibleName =
  isNewTab && typeof ariaLabel === 'string' && !/opens in a new tab/iu.test(ariaLabel)
    ? `${ariaLabel} (opens in a new tab)`
    : ariaLabel;
---

<a
  class:list={[
    'action-control',
    variant === 'link' ? 'text-action-link' : `action-${variant}`,
    `action-size-${size}`,
    className,
  ]}
  {...attributes}
  aria-label={accessibleName}
  {target}
  rel={relationship}
>
  <slot />
  {
    isNewTab && size !== 'icon' && (
      <ExternalLink
        class="size-4 shrink-0"
        aria-hidden="true"
        data-external-link-icon
      />
    )
  }
  {isNewTab && accessibleName === undefined && <span class="sr-only"> (opens in a new tab)</span>}
</a>
