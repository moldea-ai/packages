---
import type { HTMLAttributes } from 'astro/types';

import type { IStatusBadgeTone } from '../status-badge/status-badge.component.astro';

// three named sizes keep the icon at half the tile; tones reuse the status badge set plus brand emphasis
export type IIconTileSize = 'lg' | 'md' | 'sm';
export type IIconTileTone = IStatusBadgeTone | 'brand';

export interface Props extends Omit<HTMLAttributes<'span'>, 'class'> {
  size?: IIconTileSize;
  tone?: IIconTileTone;
  class?: string;
}

const {
  size = 'md',
  tone = 'neutral',
  class: className,
  'aria-hidden': ariaHidden = 'true',
  ...attributes
} = Astro.props;
const sizeClasses = {
  sm: 'size-8 rounded-md text-xs [&_img]:size-4 [&_svg]:size-4',
  md: 'size-10 rounded-lg text-sm [&_img]:size-5 [&_svg]:size-5',
  lg: 'size-12 rounded-xl text-base [&_img]:size-6 [&_svg]:size-6',
} as const;
// neutral tints from the surrounding text so one tile reads on light, muted and inverse surfaces
// status icons take the tone itself; `info-foreground` is for text on a solid info fill, not a tint
const toneClasses = {
  brand: 'bg-primary text-primary-foreground',
  danger: 'bg-destructive/10 text-destructive dark:bg-destructive/20',
  info: 'bg-info/10 text-info dark:bg-info/15',
  neutral: 'bg-current/6 dark:bg-current/12',
  success: 'bg-success/10 text-success dark:bg-success/15',
  warning: 'bg-warning/15 text-warning-foreground dark:text-warning',
} as const;
---

<span
  {...attributes}
  class:list={[
    'flex shrink-0 items-center justify-center font-semibold tabular-nums [&_img]:shrink-0 [&_svg]:shrink-0',
    sizeClasses[size],
    toneClasses[tone],
    className,
  ]}
  aria-hidden={ariaHidden}
  data-icon-tile={tone}
  data-size={size}
  ><slot /></span
>
