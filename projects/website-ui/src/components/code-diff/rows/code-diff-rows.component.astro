---
import type { ICodeDiffSection } from '@moldea.ai/website-ui/code-diff-model';
import type { ICodeOverflow } from '@moldea.ai/website-ui/code-presentation';

import CodeDiffLine from '../line/code-diff-line.component.astro';

interface Props {
  section: ICodeDiffSection;
  view: 'unified' | 'split';
  overflow: ICodeOverflow;
  hasLeadingInset?: boolean;
  hasTrailingInset?: boolean;
}
const { section, view, overflow, hasLeadingInset = false, hasTrailingInset = false } = Astro.props;
---

<div
  class:list={[view === 'split' && '@2xl/diff:hidden', section.lines.length === 0 && 'min-h-2']}
  data-diff-unified
>
  {
    section.lines.map((line, index) => (
      <CodeDiffLine
        line={line}
        overflow={overflow}
        hasLeadingInset={hasLeadingInset && index === 0}
        hasTrailingInset={hasTrailingInset && index === section.lines.length - 1}
      />
    ))
  }
</div>
{
  view === 'split' && (
    <div
      class="hidden @2xl/diff:block"
      data-diff-split
    >
      {section.rows.map((row, index) => (
        <div class="grid grid-cols-2">
          <div class="min-w-0 border-r border-border">
            <CodeDiffLine
              line={row.before}
              side="before"
              overflow={overflow}
              hasLeadingInset={hasLeadingInset && index === 0}
              hasTrailingInset={hasTrailingInset && index === section.rows.length - 1}
            />
          </div>
          <div class="min-w-0">
            <CodeDiffLine
              line={row.after}
              side="after"
              overflow={overflow}
              hasLeadingInset={hasLeadingInset && index === 0}
              hasTrailingInset={hasTrailingInset && index === section.rows.length - 1}
            />
          </div>
        </div>
      ))}
    </div>
  )
}
