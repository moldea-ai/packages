---
import type { ICodeDiffLine, ICodeDiffToken } from '@moldea.ai/website-ui/code-diff-model';
import type { ICodeOverflow } from '@moldea.ai/website-ui/code-presentation';

interface Props {
  line?: ICodeDiffLine;
  side?: 'before' | 'after';
  overflow: ICodeOverflow;
  hasLeadingInset?: boolean;
  hasTrailingInset?: boolean;
}
const { line, side, overflow, hasLeadingInset = false, hasTrailingInset = false } = Astro.props;
const kind = line?.kind ?? 'empty';
const groups: { isChanged: boolean; tokens: ICodeDiffToken[] }[] = [];
for (const token of line?.tokens ?? []) {
  const isChanged = token.isChanged === true && (kind === 'added' || kind === 'removed');
  const previous = groups.at(-1);
  if (previous?.isChanged === isChanged) previous.tokens.push(token);
  else groups.push({ isChanged, tokens: [token] });
}
---

<div
  class:list={[
    'grid min-h-6 min-w-0 font-mono text-xs leading-6',
    side && 'h-full',
    side
      ? 'grid-cols-[var(--diff-gutter-width)_1rem_minmax(0,1fr)]'
      : 'grid-cols-[var(--diff-gutter-width)_1rem_minmax(0,1fr)] @sm/diff:grid-cols-[var(--diff-gutter-width)_var(--diff-gutter-width)_1rem_minmax(0,1fr)]',
    kind === 'removed' && 'bg-destructive/8',
    kind === 'added' && 'bg-(--syntax-string)/8',
    kind === 'empty' && 'bg-secondary/30',
    hasLeadingInset && 'pt-1',
    hasTrailingInset && 'pb-1',
  ]}
  data-diff-line={kind}
>
  {
    side ? (
      <span
        class="pr-2 text-right text-muted-foreground tabular-nums select-none"
        aria-hidden="true"
      >
        {side === 'before' ? line?.oldNumber : line?.newNumber}
      </span>
    ) : (
      <>
        <span
          class="hidden pr-2 text-right text-muted-foreground tabular-nums select-none @sm/diff:block"
          aria-hidden="true"
        >
          {line?.oldNumber}
        </span>
        <span
          class="pr-2 text-right text-muted-foreground tabular-nums select-none"
          aria-hidden="true"
        >
          <span class="@sm/diff:hidden">{line?.newNumber ?? line?.oldNumber}</span>
          <span class="hidden @sm/diff:inline">{line?.newNumber}</span>
        </span>
      </>
    )
  }
  <span
    class:list={[
      'text-center select-none',
      kind === 'added' && 'text-(--syntax-string)',
      kind === 'removed' && 'text-destructive',
    ]}
    aria-hidden="true"
    >{kind === 'added' ? '+' : kind === 'removed' ? '−' : ''}</span
  >
  <div class="min-w-0 pr-3 pl-1.5">
    {
      line && (
        <>
          <span class="sr-only">
            {line.kind === 'added' ? 'Added' : line.kind === 'removed' ? 'Removed' : 'Unchanged'}{' '}
            line {line.kind === 'removed' || side === 'before' ? line.oldNumber : line.newNumber}:
          </span>
          <code
            class:list={[
              overflow === 'scroll'
                ? 'whitespace-pre'
                : '[overflow-wrap:anywhere] whitespace-pre-wrap',
            ]}
          >
            {groups.map((group) => {
              const syntax = group.tokens.map((token) => (
                <span
                  class="text-(--diff-light) dark:text-(--diff-dark)"
                  style={`--diff-light:color-mix(in srgb, ${token.lightColor ?? 'var(--foreground)'} ${group.isChanged ? 60 : 80}%, var(--foreground));--diff-dark:color-mix(in srgb, ${token.darkColor ?? 'var(--foreground)'} ${group.isChanged ? 60 : 80}%, var(--foreground))`}
                >
                  {token.content}
                </span>
              ));
              const Edit = kind === 'added' ? 'ins' : 'del';
              return group.isChanged ? (
                <Edit
                  class:list={[
                    'underline decoration-1 underline-offset-2 forced-colors:[text-decoration-color:CanvasText]',
                    kind === 'added'
                      ? 'bg-(--syntax-string)/16 decoration-(--syntax-string)'
                      : 'bg-destructive/16 decoration-destructive',
                  ]}
                  data-moldea-diff-change={kind}
                >
                  {syntax}
                </Edit>
              ) : (
                syntax
              );
            })}
          </code>
        </>
      )
    }
  </div>
</div>
