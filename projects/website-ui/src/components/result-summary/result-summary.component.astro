---
import IconTile from '../icon-tile/icon-tile.component.astro';
import type { IStatusBadgeTone } from '../status-badge/status-badge.component.astro';

// balanced presentation shared by outcome cards and slotted dialog headings
export interface Props {
  title: string;
  description: string;
  tone?: IStatusBadgeTone;
  headingId?: string;
  as?: 'p' | 'h2' | 'h3';
  ariaLabel?: string;
}

const {
  title,
  description,
  tone = 'neutral',
  headingId,
  as: Title = 'p',
  ariaLabel = 'Result',
} = Astro.props;
---

<div
  class="flex min-w-0 items-start gap-3"
  role="group"
  aria-label={ariaLabel}
>
  {
    Astro.slots.has('icon') && (
      <IconTile tone={tone}>
        <slot name="icon" />
      </IconTile>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <Title
        id={headingId}
        class="text-sm leading-5 font-semibold"
        >{title}</Title
      >
      <slot name="status" />
    </div>
    {description && <p class="text-xs leading-5 text-muted-foreground">{description}</p>}
  </div>
</div>
