---
import { ArrowUpRight, CheckCircle2, CircleAlert, Info, TriangleAlert } from '@lucide/astro';
import {
  DIAGNOSTIC_GROUP_PRESENTATIONS,
  INSPECTION_SEVERITY_PRESENTATIONS,
  type IInspectionResultView,
} from '@moldea.ai/website-ui/inspection-presentation';

import ActionLink from '../action-link/action-link.component.astro';
import InspectionDialog from '../inspection-dialog/inspection-dialog.component.astro';

// every outcome uses the same compact action; detailed evidence belongs in its dialog
export interface Props {
  id: string;
  result: IInspectionResultView;
}
const { id, result } = Astro.props;
const dialogId = `${id}-result`;
const icons = {
  danger: CircleAlert,
  info: Info,
  neutral: Info,
  success: CheckCircle2,
  warning: TriangleAlert,
};
const single = result.findings.length === 1 ? result.findings[0] : undefined;
const Icon = single ? DIAGNOSTIC_GROUP_PRESENTATIONS[single.group].icon : icons[result.tone];
const toneClasses = {
  danger: 'border-destructive/40 bg-destructive/10 [&_svg:first-child]:text-destructive',
  info: 'border-info/40 bg-info/10 [&_svg:first-child]:text-info',
  neutral: 'border-border bg-muted',
  success: 'border-success/40 bg-success/10 [&_svg:first-child]:text-success',
  warning:
    'border-warning/50 bg-warning/10 [&_svg:first-child]:text-warning-foreground dark:[&_svg:first-child]:text-warning',
};
const errors = result.findings.filter(({ severity }) => severity === 'error').length;
const warnings = result.findings.filter(
  ({ severity, accepted }) => severity === 'warning' && !accepted,
).length;
const accepted = result.findings.filter((finding) => finding.accepted).length;
const counts = [
  errors && `${errors} error${errors === 1 ? '' : 's'}`,
  warnings && `${warnings} warning${warnings === 1 ? '' : 's'}`,
  accepted && `${accepted} accepted`,
]
  .filter(Boolean)
  .join(' · ');
---

<div
  class="grid min-w-0 gap-2"
  data-inspection-list
>
  <ActionLink
    href={single ? `#${dialogId}-finding-${single.id}` : `#${dialogId}`}
    data-dialog-open={dialogId}
    data-inspection-select={single?.id ?? ''}
    aria-controls={dialogId}
    aria-haspopup="dialog"
    aria-label={`${result.label}${single ? ` ${single.code}` : ''}: View result: ${single?.title ?? result.title}`}
    variant="outline"
    size="sm"
    class={`min-h-14 w-full min-w-0 justify-start gap-3 text-foreground ${toneClasses[result.tone]}`}
    data-inspection-outcome={result.label}
  >
    <Icon
      class="size-5 shrink-0"
      aria-hidden="true"
    />
    <span class="min-w-0 flex-1 text-start whitespace-normal">
      <span>{result.label}</span>{
        result.findings.length > 1 && <span class="ml-2 text-xs font-normal">{counts}</span>
      }
      {
        single && (
          <code class="mt-0.5 block font-mono text-[11px] leading-4 font-normal break-all text-muted-foreground">
            {single.code}
          </code>
        )
      }
    </span>
    <ArrowUpRight
      class="size-3.5 shrink-0 text-muted-foreground"
      aria-hidden="true"
    />
  </ActionLink>
  {
    result.findings.length > 1 && (
      <ul
        class="grid w-full min-w-0 divide-y"
        aria-label="Inspection findings"
      >
        {result.findings.map((finding) => {
          const FindingIcon = INSPECTION_SEVERITY_PRESENTATIONS[finding.severity].icon;
          return (
            <li class="min-w-0">
              <ActionLink
                href={`#${dialogId}-finding-${finding.id}`}
                data-dialog-open={dialogId}
                data-inspection-select={finding.id}
                aria-controls={dialogId}
                aria-haspopup="dialog"
                aria-label={`View finding: ${finding.title} ${finding.code}`}
                variant="ghost"
                size="sm"
                class="w-full min-w-0 justify-start px-1 text-start text-foreground"
              >
                <FindingIcon
                  class:list={[
                    'size-4 shrink-0',
                    finding.accepted
                      ? 'text-info'
                      : finding.severity === 'error'
                        ? 'text-destructive'
                        : 'text-warning-foreground dark:text-warning',
                  ]}
                  aria-hidden="true"
                />
                <span class="min-w-0 flex-1 text-start">
                  <span class="block truncate">{finding.title}</span>
                  <code class="mt-0.5 block font-mono text-[11px] leading-4 font-normal break-all whitespace-normal text-muted-foreground">
                    {finding.code}
                  </code>
                </span>
                <ArrowUpRight
                  class="size-3.5 shrink-0 text-muted-foreground"
                  aria-hidden="true"
                />
              </ActionLink>
            </li>
          );
        })}
      </ul>
    )
  }
  <InspectionDialog
    id={dialogId}
    result={result}
  />
</div>
