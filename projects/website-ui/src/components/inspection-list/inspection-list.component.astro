---
import {
  ChevronDown,
  CircleAlert,
  CircleCheck,
  CircleMinus,
  CircleX,
  Info,
  TriangleAlert,
} from '@lucide/astro';
import {
  groupInspectionFindings,
  type IInspectionResultView,
} from '@moldea.ai/website-ui/inspection-presentation';
import CodeText from '../code-text/code-text.component.astro';
import InspectionFinding from '../inspection-finding/inspection-finding.component.astro';
import InspectionDialog from '../inspection-dialog/inspection-dialog.component.astro';
import StatusBadge from '../status-badge/status-badge.component.astro';
import InspectionBinding from './binding/inspection-binding.component.astro';

export interface Props {
  id: string;
  result: IInspectionResultView;
}
const { id, result } = Astro.props;
const { groups, accepted } = groupInspectionFindings(result.findings);
const blocking = result.findings.filter((finding) => finding.severity === 'error').length;
const warnings = result.findings.filter(
  (finding) => finding.severity === 'warning' && !finding.accepted,
).length;
const counts = [
  result.findings.length > 1 && `${result.findings.length} findings`,
  blocking > 0 && `${blocking} blocking`,
  warnings > 0 && `${warnings} warning${warnings === 1 ? '' : 's'}`,
  accepted.length > 0 && `${accepted.length} accepted`,
]
  .filter(Boolean)
  .join(' · ');
const hasSummary = result.findings.length !== 1;
const resultIcons = {
  danger: CircleAlert,
  info: Info,
  neutral: Info,
  success: CircleCheck,
  warning: TriangleAlert,
};
const ResultIcon = ['Blocked', 'Not checked', 'Refused'].includes(result.label)
  ? CircleMinus
  : result.label === 'Failed'
    ? CircleX
    : resultIcons[result.tone];
---

<div
  class="grid min-w-0 gap-3"
  data-inspection-list
  data-inspection-outcome={result.label}
>
  {
    hasSummary && (
      <div class="min-w-0">
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <StatusBadge
            label={result.label}
            tone={result.tone}
            size="sm"
          >
            <ResultIcon
              slot="icon"
              aria-hidden="true"
            />
          </StatusBadge>
          <span class="text-sm font-semibold wrap-anywhere">{result.title}</span>
          {result.code && (
            <CodeText
              value={result.code}
              title=""
              class="text-xs"
            />
          )}
        </div>
        {counts && <p class="mt-1 text-xs leading-5 text-muted-foreground">{counts}</p>}
      </div>
    )
  }
  {
    groups.map((group) => (
      <div
        role="group"
        aria-label={group.label}
        class="min-w-0"
      >
        <>
          {hasSummary && <p class="mb-3 text-sm font-semibold">{group.label}</p>}
          <ol class="grid min-w-0 gap-3">
            {group.findings.map((finding) => {
              const dialogId = `${id}-${finding.id}`;
              return (
                <li class="min-w-0">
                  <InspectionFinding
                    {finding}
                    {dialogId}
                  />
                  <InspectionDialog
                    id={dialogId}
                    {finding}
                  />
                </li>
              );
            })}
          </ol>
        </>
      </div>
    ))
  }
  {
    accepted.length > 0 && (
      <details
        class="group min-w-0 border-t pt-4"
        data-inspection-accepted
      >
        <>
          <summary class="flex w-fit max-w-full cursor-pointer list-none items-start gap-2 rounded-sm py-2 text-sm font-semibold outline-none focus-visible:ring-2 focus-visible:ring-ring pointer-coarse:min-h-11 pointer-coarse:min-w-11 [&::-webkit-details-marker]:hidden">
            <ChevronDown
              class="mt-1 size-4 shrink-0 group-open:rotate-180"
              aria-hidden="true"
            />
            Accepted warnings ({accepted.length} loaded)
          </summary>
          <p class="mb-3 text-xs leading-5 text-muted-foreground">
            Accepted in moldea.yaml. Their reasons remain visible here; acceptance does not add
            coverage.
          </p>
          <ol class="grid min-w-0 gap-3">
            {accepted.map((finding) => {
              const dialogId = `${id}-${finding.id}`;
              return (
                <li class="min-w-0">
                  <InspectionFinding
                    {finding}
                    {dialogId}
                  />
                  <InspectionDialog
                    id={dialogId}
                    {finding}
                  />
                </li>
              );
            })}
          </ol>
        </>
      </details>
    )
  }
  {
    result.bindings.length > 0 && (
      <details class="group min-w-0">
        <summary class="min-h-11 w-fit max-w-full cursor-pointer content-center rounded-sm py-2 text-xs font-medium outline-none focus-visible:ring-2 focus-visible:ring-ring pointer-coarse:min-w-11">
          View binding checks
        </summary>
        <div
          role="group"
          aria-label="Binding checks"
          class="min-w-0"
        >
          <ol class="grid min-w-0 gap-3">
            {result.bindings.map((binding) => (
              <li class="min-w-0">
                <InspectionBinding {binding} />
              </li>
            ))}
          </ol>
        </div>
      </details>
    )
  }
  {result.limitation && <p class="text-xs leading-6 text-muted-foreground">{result.limitation}</p>}
</div>
