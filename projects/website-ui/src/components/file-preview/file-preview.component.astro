---
import { FileText } from '@lucide/astro';
import { formatRepositoryPath } from '@moldea.ai/website-ui/code-presentation';

import type { IStatusBadgeTone } from '../status-badge/status-badge.component.astro';

// file presentation only; consumers own source selection, status, and body content
export interface Props {
  path: string;
  label?: string;
  tone?: IStatusBadgeTone;
  statusLayout?: 'responsive' | 'inline';
}

const { path, label, tone = 'neutral', statusLayout = 'responsive' } = Astro.props;
const displayPath = formatRepositoryPath(path);
const filenameStart = displayPath.lastIndexOf('/');
const directory = filenameStart < 0 ? '' : displayPath.slice(0, filenameStart);
const filename = filenameStart < 0 ? displayPath : displayPath.slice(filenameStart);
// conditional children can register a slot without rendering content
const body = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const hasBody = body.trim().length > 0;
const labelContent = Astro.slots.has('label') ? await Astro.slots.render('label') : '';
const hasLabelContent = labelContent.trim().length > 0;
const hasRole = Boolean(label) || hasLabelContent;
const statusContent = Astro.slots.has('status') ? await Astro.slots.render('status') : '';
const hasStatusContent = statusContent.trim().length > 0;
const toneClasses = {
  danger: 'border-border bg-background',
  info: 'border-border bg-background',
  neutral: 'border-border bg-background',
  success: 'border-border bg-secondary',
  warning: 'border-border bg-background',
} as const;
const borderClasses = {
  danger: 'border-2 border-destructive/50',
  info: 'border-info/40',
  neutral: 'border-border',
  success: 'border-border',
  warning: 'border-warning/60',
} as const;
---

<div
  class:list={['min-w-0 overflow-hidden rounded-lg border', borderClasses[tone]]}
  data-file-preview
  data-file-preview-tone={tone}
>
  <div
    class:list={[
      '@container/file-preview flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-3',
      hasBody && 'border-b',
      toneClasses[tone],
    ]}
    data-file-preview-header
  >
    <span
      class="shrink-0 text-muted-foreground"
      aria-hidden="true"
    >
      <slot name="icon"><FileText class="size-5" /></slot>
    </span>
    <div class="min-w-0 flex-1">
      {
        hasRole && (
          <div
            class="mb-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground"
            data-file-preview-role
          >
            {hasLabelContent ? <Fragment set:html={labelContent} /> : label}
          </div>
        )
      }
      <code
        class="inline-code flex w-fit max-w-full text-xs whitespace-nowrap"
        title={displayPath}
      >
        <span class="min-w-0 truncate">{directory}</span><span class="max-w-full shrink-0 truncate"
          >{filename}</span
        >
      </code>
    </div>
    {
      hasStatusContent && (
        <span
          class:list={[
            statusLayout === 'inline'
              ? 'shrink-0'
              : 'order-last basis-full pl-8 @sm/file-preview:order-none @sm/file-preview:shrink-0 @sm/file-preview:basis-auto @sm/file-preview:pl-0',
            // beside a role and path, the status shares the role's first line
            hasRole && (statusLayout === 'inline' ? 'self-start' : '@sm/file-preview:self-start'),
          ]}
          data-file-preview-status
        >
          <Fragment set:html={statusContent} />
        </span>
      )
    }
  </div>
  <Fragment set:html={body} />
</div>
