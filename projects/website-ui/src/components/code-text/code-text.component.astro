---
import type { HTMLAttributes } from 'astro/types';

/*
 * Renders a code element whose text wraps only after `/`, `_`, `.` or `-`, never mid-word.
 * A value with no permitted break and no whitespace stays on one line and truncates with an
 * ellipsis; its full text stays in the DOM and in a title unless the caller supplies one.
 */
interface Props extends HTMLAttributes<'code'> {
  value: string;
}
const { value, title, ...attributes } = Astro.props;
// mirrors splitCodeSegments in code-presentation, which this shipped source cannot import
const segments = value.split(/(?<=[^/_.-][/_.-])(?=[^/_.-])/u);
const isUnbreakable = segments.length === 1 && !/\s/u.test(value);
---

<code
  {...attributes}
  title={title ?? (isUnbreakable ? value : undefined)}
  data-code-text={isUnbreakable ? 'unbreakable' : undefined}
  >{segments.map((segment, index) => (index > 0 ? [<wbr />, segment] : segment))}</code
>
