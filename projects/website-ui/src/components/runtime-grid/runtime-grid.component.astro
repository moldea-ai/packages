---
import { ExternalLink, Plus } from '@lucide/astro';
import ActionButton from '@moldea.ai/website-ui/action-button';
import { RUNTIME_CATALOG, type IRuntimeCatalogEntry } from '@moldea.ai/website-ui/runtime-catalog';

export interface Props {
  ariaLabel?: string;
}
const { ariaLabel = 'Runtime guidance' } = Astro.props;
const listId = `runtimes-${crypto.randomUUID()}`;
const logoSources = import.meta.glob<string>('../../../runtime-logos/*.{svg,png}', {
  eager: true,
  import: 'default',
  query: '?url',
});
const packagePrefix = '@moldea.ai/website-ui/runtime-logos/';
const logoSource = (packagePath: string) =>
  logoSources[`../../../runtime-logos/${packagePath.slice(packagePrefix.length)}`];
const runtimes: IRuntimeCatalogEntry[] = [...RUNTIME_CATALOG];
---

<div data-runtime-catalog>
  <ul
    id={listId}
    class="grid gap-2 md:grid-cols-2 xl:grid-cols-3"
    aria-label={ariaLabel}
    data-runtime-grid
  >
    {
      runtimes.map((runtime) => (
        <li
          class="min-w-0 scroll-mt-24"
          id={runtime.id}
        >
          <a
            class="group flex h-full min-w-0 items-center gap-3 rounded-xl surface-link px-3 py-4 transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none motion-reduce:transition-none"
            href={runtime.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="flex size-14 shrink-0 items-center justify-center">
              <img
                class:list={[
                  runtime.logoSize === 'padded-icon' ? 'size-14' : 'size-10',
                  'object-contain',
                  runtime.darkLogoPath && 'dark:hidden',
                ]}
                src={logoSource(runtime.logoPath)}
                width="56"
                height="56"
                alt=""
                loading="lazy"
                decoding="async"
              />
              {runtime.darkLogoPath && (
                <img
                  class:list={[
                    'hidden object-contain dark:block',
                    runtime.logoSize === 'padded-icon' ? 'size-14' : 'size-10',
                  ]}
                  src={logoSource(runtime.darkLogoPath)}
                  width="56"
                  height="56"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </span>
            <span class="grid min-w-0 gap-1">
              <span class="text-sm leading-5 font-semibold text-foreground">
                {runtime.displayName}
              </span>
              <code class="text-xs leading-5 break-all text-muted-foreground">{runtime.id}</code>
              <span class="sr-only"> (opens in a new tab)</span>
            </span>
            <ExternalLink
              class="ml-auto size-3.5 shrink-0 text-muted-foreground"
              aria-hidden="true"
              data-external-link-icon
            />
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
    <ActionButton
      variant="outline"
      aria-controls={listId}
      hidden
      data-runtime-load
    >
      <Plus
        class="size-4"
        aria-hidden="true"
      />
      Load more runtimes
    </ActionButton>
    <p
      class="text-xs text-muted-foreground"
      aria-live="polite"
      data-runtime-count
    >
      {runtimes.length} runtimes
    </p>
  </div>
</div>

<script>
  /** Shows three responsive rows per batch while preserving the complete no-JavaScript list. */
  const initializeRuntimeCatalogs = () => {
    for (const catalog of document.querySelectorAll<HTMLElement>('[data-runtime-catalog]')) {
      if (catalog.dataset.initialized) continue;
      const grid = catalog.querySelector<HTMLElement>('[data-runtime-grid]');
      const button = catalog.querySelector<HTMLButtonElement>('[data-runtime-load]');
      const count = catalog.querySelector<HTMLElement>('[data-runtime-count]');
      if (!grid || !button || !count) continue;
      catalog.dataset.initialized = 'true';
      const items = [...grid.children].filter(
        (item): item is HTMLLIElement => item instanceof HTMLLIElement,
      );
      let rows = 3;
      let visibleCount = 0;
      let columns = 0;
      const update = () => {
        columns = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
        visibleCount = Math.min(rows * columns, items.length);
        for (const [index, item] of items.entries()) {
          if (index >= visibleCount && item.contains(document.activeElement)) button.focus();
          item.hidden = index >= visibleCount;
        }
        button.hidden = visibleCount === items.length;
        count.textContent = `Showing ${visibleCount} of ${items.length} runtimes`;
      };
      const controller = new AbortController();
      button.addEventListener(
        'click',
        (event) => {
          const firstNewItem = items[visibleCount];
          rows += 3;
          update();
          if (event.detail === 0 || button.hidden)
            firstNewItem?.querySelector('a')?.focus({ preventScroll: true });
        },
        { signal: controller.signal },
      );
      const observer = new ResizeObserver(() => {
        if (getComputedStyle(grid).gridTemplateColumns.split(' ').length !== columns) update();
      });
      const revealRequestedRuntime = () => {
        const index = items.findIndex((item) => item.id === location.hash.slice(1));
        if (index < 0) return;
        rows = Math.max(rows, Math.ceil((index + 1) / (3 * columns)) * 3);
        update();
        items[index]?.scrollIntoView({ block: 'start' });
      };
      update();
      revealRequestedRuntime();
      window.addEventListener('hashchange', revealRequestedRuntime, { signal: controller.signal });
      observer.observe(grid);
      document.addEventListener(
        'astro:before-swap',
        () => {
          controller.abort();
          observer.disconnect();
        },
        { once: true, signal: controller.signal },
      );
    }
  };
  initializeRuntimeCatalogs();
  document.addEventListener('astro:page-load', initializeRuntimeCatalogs);
</script>
