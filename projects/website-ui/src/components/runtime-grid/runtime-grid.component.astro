---
import { ExternalLink } from '@lucide/astro';
import { RUNTIME_CATALOG, type IRuntimeCatalogEntry } from '@moldea.ai/website-ui/runtime-catalog';

export interface Props {
  ariaLabel?: string;
  hrefBase?: string;
}
const { ariaLabel = 'Runtime guidance', hrefBase = 'https://packages.moldea.ai/runtimes/' } =
  Astro.props;
const isExternal = /^https?:\/\//u.test(hrefBase);
const logoSources = import.meta.glob<string>('../../../runtime-logos/*.{svg,png}', {
  eager: true,
  import: 'default',
  query: '?url',
});
const packagePrefix = '@moldea.ai/website-ui/runtime-logos/';
const logoSource = (packagePath: string) =>
  logoSources[`../../../runtime-logos/${packagePath.slice(packagePrefix.length)}`];
const runtimes: IRuntimeCatalogEntry[] = [...RUNTIME_CATALOG];
---

<ul
  class="grid gap-2 md:grid-cols-2 xl:grid-cols-3"
  aria-label={ariaLabel}
  data-runtime-grid
>
  {
    runtimes.map((runtime) => (
      <li
        class="min-w-0 scroll-mt-24"
        id={hrefBase === '' ? runtime.id : undefined}
      >
        <a
          class="group flex h-full min-w-0 items-center gap-4 rounded-xl surface-link bg-secondary/30 px-4 py-5 transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none motion-reduce:transition-none"
          href={`${hrefBase}#${runtime.id}`}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          <span class="flex h-12 w-24 shrink-0 items-center justify-center">
            <img
              class:list={[
                runtime.logoSize === 'padded-wordmark'
                  ? 'h-12 w-24 scale-[1.4]'
                  : runtime.logoSize === 'wordmark'
                    ? 'h-8 w-24'
                    : 'size-10',
                'object-contain',
                runtime.darkLogoPath && 'dark:hidden',
              ]}
              src={logoSource(runtime.logoPath)}
              width="96"
              height="48"
              alt=""
              loading="lazy"
              decoding="async"
            />
            {runtime.darkLogoPath && (
              <img
                class:list={[
                  runtime.logoSize === 'padded-wordmark'
                    ? 'h-12 w-24 scale-[1.4]'
                    : runtime.logoSize === 'wordmark'
                      ? 'h-8 w-24'
                      : 'size-10',
                  'hidden object-contain dark:block',
                ]}
                src={logoSource(runtime.darkLogoPath)}
                width="96"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </span>
          <span class="grid min-w-0 gap-1">
            <span class="text-sm leading-5 font-semibold text-foreground">
              {runtime.displayName}
            </span>
            <code class="text-xs leading-5 break-all text-muted-foreground">{runtime.id}</code>
          </span>
          {isExternal && (
            <ExternalLink
              class="ml-auto size-3.5 shrink-0 text-muted-foreground"
              aria-hidden="true"
              data-external-link-icon
            />
          )}
        </a>
      </li>
    ))
  }
</ul>
