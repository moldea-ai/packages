---
import { ClientRouter, fade } from 'astro:transitions';
import NavigationProgress from '@moldea.ai/website-ui/navigation-progress';
import ThemeBootstrap from '@moldea.ai/website-ui/theme-bootstrap';
import { withBase } from '@moldea.ai/website-ui/site';

import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import { SITE_ALTERNATE_NAME, SITE_NAME, SOCIAL_IMAGE_ALT } from '../lib/site/constants.ts';
import '../styles/global.css';

interface Props {
  breadcrumbs?: Array<{ href?: string; label: string }>;
  description: string;
  noIndex?: boolean;
  title: string;
}

const { breadcrumbs = [], description, noIndex = false, title } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const pageTitle = `${title} · ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalHomeUrl = new URL(withBase('/', basePath), Astro.site);
const openGraphImage = new URL(withBase('/open-graph/ogimage.png', basePath), Astro.site);
const structuredWebsite =
  basePath === '/' && canonicalUrl.href === canonicalHomeUrl.href
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        alternateName: SITE_ALTERNATE_NAME,
        url: canonicalHomeUrl.href,
      }
    : null;
const structuredBreadcrumbs = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: new URL(withBase(item.href, basePath), Astro.site).href } : {}),
      })),
    }
  : null;
const structuredBreadcrumbJson = structuredBreadcrumbs
  ? JSON.stringify(structuredBreadcrumbs).replaceAll('<', '\\u003c')
  : '';
const structuredWebsiteJson = structuredWebsite
  ? JSON.stringify(structuredWebsite).replaceAll('<', '\\u003c')
  : '';
---

<!doctype html>
<html
  lang="en"
  data-theme="system"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="theme-color"
      content="oklch(99.426% 0.00274 84.294)"
    />
    <ClientRouter fallback="animate" />
    {
      noIndex && (
        <meta
          name="robots"
          content="noindex, follow"
        />
      )
    }
    {
      !noIndex && (
        <link
          rel="canonical"
          href={canonicalUrl}
        />
      )
    }
    <link
      rel="icon"
      href={withBase('/favicon.ico', basePath)}
      sizes="any"
    />
    {
      !noIndex && (
        <>
          <meta
            property="og:type"
            content="website"
          />
          <meta
            property="og:locale"
            content="en_US"
          />
          <meta
            property="og:site_name"
            content={SITE_NAME}
          />
          <meta
            property="og:title"
            content={pageTitle}
          />
          <meta
            property="og:description"
            content={description}
          />
          <meta
            property="og:url"
            content={canonicalUrl}
          />
          <meta
            property="og:image"
            content={openGraphImage}
          />
          <meta
            property="og:image:secure_url"
            content={openGraphImage}
          />
          <meta
            property="og:image:type"
            content="image/png"
          />
          <meta
            property="og:image:width"
            content="1730"
          />
          <meta
            property="og:image:height"
            content="909"
          />
          <meta
            property="og:image:alt"
            content={SOCIAL_IMAGE_ALT}
          />
          <meta
            name="twitter:card"
            content="summary_large_image"
          />
          <meta
            name="twitter:title"
            content={pageTitle}
          />
          <meta
            name="twitter:description"
            content={description}
          />
          <meta
            name="twitter:image"
            content={openGraphImage}
          />
          <meta
            name="twitter:image:alt"
            content={SOCIAL_IMAGE_ALT}
          />
        </>
      )
    }
    <title>{pageTitle}</title>
    <ThemeBootstrap storageKey="moldea-website-theme" />
    {
      structuredWebsite && (
        <script
          is:inline
          type="application/ld+json"
          set:html={structuredWebsiteJson}
        />
      )
    }
    {
      structuredBreadcrumbs && (
        <script
          is:inline
          type="application/ld+json"
          set:html={structuredBreadcrumbJson}
        />
      )
    }
  </head>
  <body>
    <NavigationProgress />
    <a
      class="fixed start-3 top-3 z-[100] -translate-y-24 rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground focus:translate-y-0"
      href="#main-content"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main
      id="main-content"
      transition:animate={fade({ duration: 180 })}
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
