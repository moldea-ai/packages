---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YouTubeVideoDialog from '@moldea.ai/website-ui/youtube-video-dialog';

// page-level cover previews share the package's trigger, icons, and playback lifecycle
export interface Props {
  id: string;
  videoUrl: string;
  title: string;
  triggerLabel: string;
  cover: ImageMetadata;
  loading?: 'eager' | 'lazy';
}

const { id, videoUrl, title, triggerLabel, cover, loading = 'lazy' } = Astro.props;
---

<div
  class="relative aspect-video min-w-0 rounded-xl border border-border bg-card shadow-surface focus-within:ring-2 focus-within:ring-foreground focus-within:ring-offset-2 focus-within:ring-offset-background"
  data-video-preview={id}
>
  <Image
    src={cover}
    alt=""
    width={1024}
    height={576}
    widths={[320, 640, 1024, 2048]}
    sizes="(min-width: 64rem) 560px, (min-width: 40rem) calc(100vw - 5rem), calc(100vw - 2rem)"
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    decoding="async"
    class="h-full w-full rounded-xl object-contain"
  />
  <div class="absolute inset-0 flex items-end justify-end p-3 sm:p-4">
    <div class="max-w-full rounded-lg bg-background">
      <YouTubeVideoDialog
        {id}
        {videoUrl}
        {title}
        {triggerLabel}
        triggerVariant="primary"
        triggerSize="lg"
        triggerClass="max-w-full whitespace-normal text-left font-bold shadow-raised after:absolute after:inset-0 after:cursor-pointer after:rounded-xl after:content-['']"
      >
        <Image
          slot="poster"
          src={cover}
          alt=""
          width={1024}
          height={576}
          widths={[320, 640, 1024, 2048]}
          sizes="(min-width: 66rem) 974px, (min-width: 40rem) calc(100vw - 5rem), calc(100vw - 2rem)"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </YouTubeVideoDialog>
    </div>
  </div>
</div>
