---
import { ArrowUpRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IAdapterPage } from '../../lib/model/types.ts';
import type { IAdapterDiscoveryCopy } from '../../lib/discovery-copy/index.ts';
import AdapterCompanyLogo from '../adapter-company-logo.astro';
import StatusBadge from '../status-badge.astro';

// runtime-specific directory entry with independently linked compatibility targets
interface Props {
  adapter: IAdapterPage;
  copy: IAdapterDiscoveryCopy;
}

const { adapter, copy } = Astro.props;
const route = withBase(adapter.route, import.meta.env.BASE_URL);
---

<article
  class="grid min-w-0 gap-2 py-3 md:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] md:items-center md:gap-6"
  aria-label={copy.name}
>
  <div class="min-w-0">
    <h3>
      <a
        class="inline-flex min-h-11 max-w-full items-center gap-3 rounded-sm font-semibold text-foreground link-feedback"
        href={route}
      >
        <AdapterCompanyLogo
          adapterId={adapter.id}
          compact
        />
        <span class="min-w-0">{copy.name}</span>
        <ArrowUpRight
          class="size-4 shrink-0"
          aria-hidden="true"
        />
      </a>
    </h3>
    {
      adapter.entry.implementationStatus !== 'available' && (
        <div class="mt-3">
          <StatusBadge kind={adapter.entry.implementationStatus} />
        </div>
      )
    }
  </div>
  {
    adapter.entry.targets?.length ? (
      <ul
        class="flex min-w-0 flex-wrap gap-2"
        aria-label={`${copy.name} inspection targets`}
      >
        {adapter.entry.targets.map((target) => (
          <li class="min-w-0">
            <a
              class:list={[
                'flex min-h-11 flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border px-3 py-2 text-sm',
                target.maturity === 'supported' && 'surface-link bg-secondary/40',
                target.maturity === 'experimental' && 'surface-link-warning',
                target.maturity === 'deprecated' && 'surface-link-danger',
              ]}
              id={`${adapter.id}-${target.id}`}
              href={`${route}#${adapter.id}-${target.id}`}
              aria-label={`${copy.targets[target.id]}, ${target.id}, ${target.maturity}`}
            >
              <span class="font-medium">{copy.targets[target.id]}</span>
              {target.maturity !== 'supported' && <StatusBadge kind={target.maturity} />}
              <ArrowUpRight
                class="size-3.5 shrink-0 text-muted-foreground"
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-muted-foreground md:self-center">No published inspection targets.</p>
    )
  }
</article>
