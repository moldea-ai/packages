---
import { BookOpen, ExternalLink, Package } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import DocumentationShell from '@moldea.ai/website-ui/documentation-shell';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import type { IRenderedMarkdownHeading } from '@moldea.ai/website-ui/markdown';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IPackageDocument, IPublicPackage } from '../lib/model/types.ts';

interface Props {
  allPackages: IPublicPackage[];
  currentRoute: string;
  document?: IPackageDocument | null;
  headings?: readonly IRenderedMarkdownHeading[];
  packageModel: IPublicPackage;
  pageDescription: string;
  pageTitle: string;
}

const {
  allPackages,
  currentRoute,
  document,
  headings = [],
  packageModel,
  pageDescription,
  pageTitle,
} = Astro.props;
const basePath = import.meta.env.BASE_URL;
const familyRoute = packageModel.family === 'runtime-adapters' ? '/adapters/' : '/packages/';
const familyLabel =
  packageModel.family === 'runtime-adapters'
    ? 'Runtime Adapters'
    : packageModel.family === 'website-foundations'
      ? 'Website Foundations'
      : 'Packages';
const packageByName = new Map(allPackages.map((candidate) => [candidate.name, candidate]));
const isApiReference = currentRoute.endsWith('/api/');
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: familyRoute, label: familyLabel },
  ...(document?.slug || isApiReference
    ? [{ href: packageModel.route, label: packageModel.name }]
    : []),
  { label: isApiReference ? 'API reference' : document?.slug ? pageTitle : packageModel.name },
];
const navigationItems = [
  ...packageModel.documents.map((item) => ({
    href: item.route,
    label: item.navigationTitle,
  })),
  ...(packageModel.api.length > 0
    ? [{ href: `${packageModel.route}api/`, label: 'API reference' }]
    : []),
];
---

<DocumentationShell
  {basePath}
  {breadcrumbs}
  {currentRoute}
  {headings}
  navigationAriaLabel={`${packageModel.name} documentation`}
  navigationGroups={[{ items: navigationItems, label: 'Documentation' }]}
  outlineEmptyLabel="Generated from public exports."
>
  <header
    slot="header"
    class="mb-10 border-b border-border pb-8"
  >
    <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border bg-muted px-3 py-1.5 font-semibold"
      >
        <Package
          class="size-3.5"
          aria-hidden="true"
        />
        v{packageModel.version}
      </span>
      <span class="text-muted-foreground">Public package</span>
    </div>
    <h1 class="text-4xl leading-tight font-semibold tracking-[-0.04em] break-words sm:text-5xl">
      {pageTitle}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">
      <InlineBrandText text={pageDescription} />
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <ActionLink
        href={packageModel.sourceUrl}
        size="md"
        target="_blank"
        rel="noopener noreferrer"
      >
        Source <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        href={packageModel.npmUrl}
        size="md"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        npm <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </header>

  <slot />

  {
    (packageModel.dependencies.length > 0 || packageModel.dependents.length > 0) && (
      <section
        class="surface-card mt-14 grid gap-6 p-6 sm:grid-cols-2"
        aria-labelledby="relationships-title"
      >
        <div>
          <h2
            id="relationships-title"
            class="mb-3 flex items-center gap-2 font-semibold"
          >
            <BookOpen
              class="size-4"
              aria-hidden="true"
            />{' '}
            Package relationships
          </h2>
          <p class="text-sm leading-6 text-muted-foreground">
            Dependencies come directly from this package manifest; dependents are derived from the
            same public inventory.
          </p>
        </div>
        <div class="grid gap-4 text-sm">
          {packageModel.dependencies.length > 0 && (
            <div>
              <p class="mb-2 font-semibold text-muted-foreground">Depends on</p>
              <div class="flex flex-wrap gap-2">
                {packageModel.dependencies.map((name) => {
                  const dependency = packageByName.get(name);
                  return dependency ? (
                    <a
                      class="rounded-md bg-muted px-2.5 py-1.5 font-mono hover:underline"
                      href={withBase(dependency.route, basePath)}
                    >
                      {name}
                    </a>
                  ) : (
                    <span class="rounded-md bg-muted px-2.5 py-1.5 font-mono">{name}</span>
                  );
                })}
              </div>
            </div>
          )}
          {packageModel.dependents.length > 0 && (
            <div>
              <p class="mb-2 font-semibold text-muted-foreground">Used by</p>
              <div class="flex flex-wrap gap-2">
                {packageModel.dependents.map((name) => {
                  const dependent = packageByName.get(name);
                  return dependent ? (
                    <a
                      class="rounded-md bg-muted px-2.5 py-1.5 font-mono hover:underline"
                      href={withBase(dependent.route, basePath)}
                    >
                      {name}
                    </a>
                  ) : null;
                })}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
</DocumentationShell>
