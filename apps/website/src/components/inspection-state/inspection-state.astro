---
import type { IInspectionExampleState } from '../../lib/inspection-example/index.ts';
import { InspectionDiagram } from '../inspection-diagram/index.ts';
import { InspectionResult } from '../inspection-result/index.ts';

// one always-visible frame of the real reference-check sequence
interface Props {
  state: IInspectionExampleState;
}
const { state } = Astro.props;
---

<article
  id={`inspection-${state.id}`}
  class="example-card flex flex-col max-sm:border-t max-sm:py-5"
  aria-labelledby={`inspection-${state.id}-title`}
>
  <header class="example-card-header">
    <h3
      id={`inspection-${state.id}-title`}
      class="example-card-title flex-1"
    >
      {state.label}
    </h3>
  </header>
  <div class="flex-1">
    <InspectionDiagram {state} />
  </div>
  <div class="example-card-footer">
    <InspectionResult
      id={`inspection-${state.id}`}
      result={state.result}
      summary={state.id}
      files={state.files}
    />
  </div>
</article>
