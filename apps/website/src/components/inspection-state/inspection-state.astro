---
import type { IInspectionExampleState } from '../../lib/inspection-example/index.ts';
import { InspectionDiagram } from '../inspection-diagram/index.ts';
import { InspectionResult } from '../inspection-result/index.ts';

// one always-visible frame of the real reference-check sequence
interface Props {
  state: IInspectionExampleState;
}
const { state } = Astro.props;
---

<article
  id={`inspection-${state.id}`}
  class="grid min-w-0 grid-rows-[auto_auto_1fr] border-t py-5 first:border-t-0 sm:p-6 lg:row-span-3 lg:grid-rows-subgrid lg:border-t-0 lg:border-l lg:first:border-l-0"
  aria-labelledby={`inspection-${state.id}-title`}
>
  <header class="example-card-header">
    <h3
      id={`inspection-${state.id}-title`}
      class="example-card-title flex-1"
    >
      {state.label}
    </h3>
  </header>
  <InspectionDiagram {state} />
  <div class="example-card-footer">
    <InspectionResult
      id={`inspection-${state.id}`}
      result={state.result}
      summary={state.id}
      files={state.files}
      isBindingDisclosureOpen
    />
  </div>
</article>

<style>
  /* inline finding details need natural spacing when scripting is unavailable. */
  @media (scripting: enabled) and (min-width: 64rem) {
    :global(html:has(script))
      .example-card-footer:has(
        > :global([data-inspection-list] > :is(details[open], [role='group']))
      ) {
      display: grid;
    }

    :global(html:has(script))
      .example-card-footer
      > :global([data-inspection-list]:has(> details[open])) {
      align-content: space-between;
    }

    :global(html:has(script)) .example-card-footer :global([data-inspection-list] > [role='group']),
    :global(html:has(script))
      .example-card-footer
      :global([data-inspection-list] > [role='group'] > ol) {
      display: grid;
    }

    :global(html:has(script))
      .example-card-footer
      :global([data-inspection-list] > [role='group'] > ol > li) {
      display: grid;
      grid-template-rows: 1fr auto;
    }
  }
</style>
