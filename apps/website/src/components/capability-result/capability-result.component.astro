---
import InspectionList from '@moldea.ai/website-ui/inspection-list';

import type { ICapabilityCase } from '../../lib/capabilities/index.ts';
import { getCapabilityInspectionView } from '../inspection-result/index.ts';

interface Props {
  example: ICapabilityCase;
}
const { example } = Astro.props;
const result = getCapabilityInspectionView(example);
---

<InspectionList
  id={example.id}
  result={result}
/>
