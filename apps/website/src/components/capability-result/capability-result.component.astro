---
import { CircleAlert, ScanLine } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import Dialog from '@moldea.ai/website-ui/dialog';
import ResultSummary from '@moldea.ai/website-ui/result-summary';
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import {
  getCapabilityOutcome,
  getCapabilityResultExcerpt,
  type ICapabilities,
  type ICapabilityCase,
} from '../../lib/capabilities/index.ts';

// result semantics and excerpt selection belong to the packages website
interface Props {
  example: ICapabilityCase;
  catalog: ICapabilities;
}
const { example, catalog } = Astro.props;
const id = `result-${example.id}`;
const outcome = getCapabilityOutcome(example, catalog);
const Icon = outcome.tone === 'danger' || outcome.tone === 'warning' ? CircleAlert : ScanLine;
---

<Dialog
  {id}
  title={outcome.title}
  triggerLabel="View result"
  triggerAriaLabel={`View result: ${example.title}`}
  closeLabel="Close capability result"
  isOverlayCloseEnabled
>
  <ResultSummary
    slot="heading"
    title={outcome.title}
    description={outcome.description}
    tone={outcome.tone}
    as="h2"
    headingId={`${id}-title`}
    hideIconOnMobile
  >
    <Icon
      slot="icon"
      class="size-5"
    />
  </ResultSummary>
  <div class="grid min-w-0 gap-5">
    <dl class="grid gap-3 border-b pb-4 text-xs sm:grid-cols-2">
      <div class="min-w-0">
        <dt class="mb-1 text-muted-foreground">Responsible package</dt><dd>
          <code class="break-all">{example.packageName}</code>
        </dd>
      </div>
      <div class="min-w-0">
        <dt class="mb-1 text-muted-foreground">Operation</dt><dd>
          <code class="inline-code break-all">{example.operation}</code>
        </dd>
      </div>
    </dl>
    <div class="min-w-0">
      <div class="mb-3 flex min-w-0 items-center justify-between gap-3">
        <p class="text-xs font-semibold text-muted-foreground">Executed result excerpt</p>
        <StatusBadge
          size="sm"
          label={outcome.label}
          tone={outcome.tone}
        />
      </div>
      <CodeBlock
        source={JSON.stringify(getCapabilityResultExcerpt(example.result), null, 2)}
        language="json"
        copyable={false}
      />
    </div>
    <p class="text-xs leading-6 text-muted-foreground">
      <InlineBrandText text={example.limitation} />
    </p>
  </div>
</Dialog>
