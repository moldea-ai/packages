---
import StatusBadge from '@moldea.ai/website-ui/status-badge';

interface Props {
  kind: 'available' | 'deprecated' | 'experimental' | 'in-development' | 'planned' | 'supported';
  label?: string;
  truncate?: boolean;
}

const { kind, label = kind, truncate = false } = Astro.props;
const tones = {
  available: 'success',
  deprecated: 'danger',
  experimental: 'warning',
  'in-development': 'info',
  planned: 'neutral',
  supported: 'success',
} as const;
const borderStyles = {
  available: 'solid',
  deprecated: 'dotted',
  experimental: 'dashed',
  'in-development': 'solid',
  planned: 'solid',
  supported: 'solid',
} as const;
---

<StatusBadge
  borderStyle={borderStyles[kind]}
  {label}
  tone={tones[kind]}
  {truncate}
/>
