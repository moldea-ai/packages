---
import { ExternalLink } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import SiteFooterShell from '@moldea.ai/website-ui/site-footer';
import { withBase } from '@moldea.ai/website-ui/site';

import Logo from './logo.astro';

const basePath = import.meta.env.BASE_URL;
---

<SiteFooterShell>
  <div slot="brand">
    <Logo />
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      <InlineBrandText
        text="Open-source tools for moldea project knowledge, declared connections, and structural checks."
      />
    </p>
  </div>
  <nav
    slot="primary-navigation"
    class="grid content-start gap-3 text-sm"
    aria-label="Documentation"
  >
    <p class="font-bold">Documentation</p>
    <a
      class="w-fit plain-link"
      href={withBase('/getting-started/', basePath)}
      >Get started</a
    >
    <a
      class="w-fit plain-link"
      href={withBase('/capabilities/', basePath)}
      >Capabilities</a
    >
    <a
      class="w-fit plain-link"
      href={withBase('/packages/', basePath)}
      >Packages</a
    >
    <a
      class="w-fit plain-link"
      href={withBase('/adapters/', basePath)}
      >Adapters</a
    >
    <a
      class="w-fit plain-link"
      href={withBase('/repository-format/', basePath)}
    >
      Repository Format
    </a>
    <a
      class="w-fit plain-link"
      href={withBase('/llms.txt', basePath)}
      >llms.txt</a
    >
  </nav>
  <nav
    slot="secondary-navigation"
    class="grid content-start gap-3 text-sm"
    aria-label="Project links"
  >
    <p class="font-bold">Project</p>
    <a
      class="inline-flex w-fit items-center gap-1.5 plain-link"
      href="https://moldea.ai"
      target="_blank"
      rel="noopener noreferrer"
      >Cloud <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      /></a
    >
    <a
      class="inline-flex w-fit items-center gap-1.5 plain-link"
      href="https://skill.moldea.ai/"
      target="_blank"
      rel="noopener noreferrer"
      >Agent Skill <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      /></a
    >
    <a
      class="inline-flex w-fit items-center gap-1.5 plain-link"
      href="https://github.com/moldea-ai/packages"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <a
      class="inline-flex w-fit items-center gap-1.5 plain-link"
      href="https://github.com/moldea-ai/packages/issues"
      target="_blank"
      rel="noopener noreferrer"
    >
      Issues <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <span class="text-muted-foreground">MIT licensed</span>
  </nav>
</SiteFooterShell>
