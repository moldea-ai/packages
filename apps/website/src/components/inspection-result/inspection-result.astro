---
import type { IProjectValidationResult } from '@moldea.ai/core';
import InspectionList from '@moldea.ai/website-ui/inspection-list';

import type { ICapabilityFile } from '../../lib/capabilities/index.ts';
import {
  getInspectionSummaryCopy,
  type IInspectionSummaryKind,
} from '../inspection-summary/index.ts';

import { getProjectInspectionView } from './presentation/index.ts';

interface Props {
  id: string;
  result: IProjectValidationResult;
  summary: IInspectionSummaryKind;
  files?: ICapabilityFile[];
}
const { id, result, summary, files = [] } = Astro.props;
const { title } = getInspectionSummaryCopy(result, summary);
const view = getProjectInspectionView(result, title, files);
---

<InspectionList
  id={id}
  result={view}
/>
