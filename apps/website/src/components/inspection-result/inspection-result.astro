---
import Dialog from '@moldea.ai/website-ui/dialog';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import type { IInspectionResultExcerpt } from '../../lib/inspection-example/index.ts';
import {
  getInspectionSummaryCopy,
  InspectionSummary,
  type IInspectionSummaryKind,
} from '../inspection-summary/index.ts';

// Core-specific dialog presentation shared by both real examples
interface Props {
  id: string;
  triggerAriaLabel: string;
  result: IInspectionResultExcerpt;
  summary: IInspectionSummaryKind;
  subjectLabel: string;
  subject: string;
}
const { id, triggerAriaLabel, result, summary, subjectLabel, subject } = Astro.props;
const { title } = getInspectionSummaryCopy(result, summary);
const resultHtml = await renderMarkdownFragment(
  `\`\`\`json\n${JSON.stringify(result, null, 2)}\n\`\`\``,
);
---

<Dialog
  {id}
  {title}
  triggerLabel="View result"
  {triggerAriaLabel}
  closeLabel="Close Core result"
  isOverlayCloseEnabled
>
  <InspectionSummary
    slot="heading"
    headingId={`${id}-title`}
    {result}
    {summary}
    hideIconOnMobile
  >
    <StatusBadge
      slot="status"
      size="sm"
      label={result.valid ? 'Valid' : 'Invalid'}
      tone={result.valid ? 'success' : 'danger'}
    />
  </InspectionSummary>
  <div class="grid min-w-0 gap-6">
    <dl class="grid gap-4 border-b pb-4 text-sm sm:grid-cols-2">
      <div class="min-w-0">
        <dt class="mb-2 text-xs font-medium text-muted-foreground">{subjectLabel}</dt>
        <dd><code class="break-all">{subject}</code></dd>
      </div>
      <div class="min-w-0">
        <dt class="mb-2 text-xs font-medium text-muted-foreground">Diagnostics</dt>
        <dd class="font-mono">{result.diagnostics.length}</dd>
      </div>
    </dl>
    <div class="min-w-0">
      <p class="mb-3 text-xs font-semibold text-muted-foreground">Core validation result excerpt</p>
      <div
        class="prose-moldea text-sm [&_pre]:m-0 [&_pre]:p-4 [&_pre]:text-xs [&_pre]:leading-6"
        set:html={resultHtml}
      />
    </div>
    <p class="text-xs leading-6 text-muted-foreground">
      Generated by Core from this example’s files. A valid result confirms structure and references,
      not program behavior.
    </p>
  </div>
</Dialog>
