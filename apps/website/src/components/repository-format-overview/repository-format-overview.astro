---
import { ArrowRight, FileText, Folder } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

interface Props {
  repositoryFormatRoute: string;
}
const { repositoryFormatRoute } = Astro.props;
---

<section
  class="page-shell py-12 sm:py-16"
  aria-labelledby="repository-contents-title"
>
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="eyebrow mb-4">Knowledge that lives with the code</p>
      <h2
        id="repository-contents-title"
        class="section-title font-semibold"
      >
        A small structure.<br />A shared record.
      </h2>
      <p class="mt-6 max-w-xl leading-8 text-muted-foreground">
        Two required files establish the repository's project context and declared connections. Add
        more context, decision records, or agent instructions as the project needs them. The files
        stay in Git, where your team can read and review them.
      </p>
      <ActionLink
        class="mt-6"
        href={withBase(repositoryFormatRoute, import.meta.env.BASE_URL)}
        variant="link"
        >Read the format specification <ArrowRight
          class="size-4"
          aria-hidden="true"
        /></ActionLink
      >
    </div>
    <div class="min-w-0 border-y py-5 sm:rounded-xl sm:border sm:bg-card sm:p-6">
      <h3 class="mb-5 flex items-center gap-3 font-mono text-sm">
        <Folder
          class="size-5 text-muted-foreground"
          aria-hidden="true"
        />moldea/
      </h3>
      <ul
        class="space-y-5"
        aria-label="moldea directory"
      >
        <li>
          <p class="flex flex-wrap items-center gap-2">
            <FileText
              class="size-4 text-muted-foreground"
              aria-hidden="true"
            /><code class="font-semibold">moldea.yaml</code><span
              class="text-xs font-semibold text-muted-foreground">Required</span
            >
          </p><p class="mt-1 text-sm leading-6 text-muted-foreground">
            Declares the format version and connections between project knowledge and code.
          </p>
        </li>
        <li>
          <p class="flex flex-wrap items-center gap-2">
            <FileText
              class="size-4 text-muted-foreground"
              aria-hidden="true"
            /><code class="font-semibold">project.md</code><span
              class="text-xs font-semibold text-muted-foreground">Required</span
            >
          </p><p class="mt-1 text-sm leading-6 text-muted-foreground">
            Explains the project's purpose and context in Markdown.
          </p>
        </li>
        <li class="border-t pt-4">
          <p class="font-mono text-sm">context/ · decisions/ · agents/</p><p
            class="mt-1 text-sm leading-6 text-muted-foreground"
          >
            Optional context, decision records, and agent instructions.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
