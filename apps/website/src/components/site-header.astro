---
import SiteHeaderShell from '@moldea.ai/website-ui/site-header';
import { isPublicRouteActive, withBase } from '@moldea.ai/website-ui/site';

import Logo from './logo.astro';

const navigation = [
  { href: '/packages/', label: 'Packages' },
  { href: '/adapters/', label: 'Adapters' },
  { href: '/compatibility/', label: 'Compatibility' },
  { href: '/repository-format/', label: 'Repository Format' },
] as const;
const currentPathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL;
const navigationItems = navigation.map(({ href, label }) => ({
  href: withBase(href, basePath),
  isActive: isPublicRouteActive(currentPathname, href, basePath),
  label,
}));
const searchHref = withBase('/search/', basePath);
const isSearchActive = isPublicRouteActive(currentPathname, '/search/', basePath);
---

<SiteHeaderShell
  breakpoint="lg"
  mobileNavigationAriaLabel="Mobile navigation"
  navigationItems={navigationItems}
  searchAriaLabel="Search documentation"
  searchHref={searchHref}
  searchIsActive={isSearchActive}
  sourceAriaLabel="moldea packages on GitHub"
  sourceHref="https://github.com/moldea-ai/packages"
  themeStorageKey="moldea-website-theme"
>
  <Logo slot="brand" />
</SiteHeaderShell>
