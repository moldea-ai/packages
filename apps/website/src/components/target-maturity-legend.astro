---
import StatusBadge from './status-badge.astro';
---

<section
  class="mb-8 space-y-3"
  aria-labelledby="target-maturity-legend-title"
>
  <h2
    id="target-maturity-legend-title"
    class="text-xs font-bold tracking-[0.12em] text-muted-foreground uppercase"
  >
    Target maturity
  </h2>
  <ul
    class="grid gap-3 text-sm leading-6 sm:grid-cols-3"
    aria-label="Target maturity legend"
  >
    <li>
      <StatusBadge kind="supported" />
      <p class="mt-2 text-muted-foreground">Production-ready within its exact published scope.</p>
    </li>
    <li>
      <StatusBadge kind="experimental" />
      <p class="mt-2 text-muted-foreground">
        Verified and fixture-backed, but not production-ready.
      </p>
    </li>
    <li>
      <StatusBadge kind="deprecated" />
      <p class="mt-2 text-muted-foreground">
        Documented for existing users; new adoption is discouraged.
      </p>
    </li>
  </ul>
</section>
