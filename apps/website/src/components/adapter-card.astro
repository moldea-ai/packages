---
import { ArrowUpRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IAdapterPage } from '../lib/model/types.ts';
import type { IAdapterDiscoveryCopy } from '../lib/discovery-copy/index.ts';
import AdapterCompanyLogo from './adapter-company-logo.astro';

interface Props {
  adapter: IAdapterPage;
  copy: IAdapterDiscoveryCopy;
}

const { adapter, copy } = Astro.props;
const basePath = import.meta.env.BASE_URL;
---

<a
  class="interactive-card group flex h-full min-w-0 flex-col border-b py-5 sm:rounded-xl sm:border sm:bg-card sm:p-6 sm:shadow-surface"
  href={withBase(adapter.route, basePath)}
>
  <div class="mb-3 flex items-center gap-3">
    <AdapterCompanyLogo
      adapterId={adapter.id}
      compact
    />
    <h3 class="min-w-0 text-lg font-semibold">{copy.name}</h3>
    <ArrowUpRight
      class="ml-auto size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground motion-reduce:transition-none"
      aria-hidden="true"
    />
  </div>
  <p class="text-xs leading-6 break-all text-muted-foreground">
    <code>{adapter.entry.implementation.package}</code>
  </p>
  <ul
    class="mt-auto flex flex-wrap gap-2 pt-3"
    aria-label={`${copy.name} inspection targets`}
  >
    {
      adapter.entry.targets?.map((target) => (
        <li class="rounded-md border bg-muted px-2 py-1 text-xs text-muted-foreground">
          {copy.targets[target.id]}
        </li>
      ))
    }
  </ul>
</a>
