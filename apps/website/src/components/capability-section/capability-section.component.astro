---
import { ArrowUpRight, ChevronDown } from '@lucide/astro';
import ActionButton from '@moldea.ai/website-ui/action-button';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import type {
  ICapabilities,
  ICapabilityCase,
  ICapabilityGroup,
} from '../../lib/capabilities/index.ts';
import { CapabilityExample } from '../capability-example/index.ts';

// every section keeps its explanation, illustrations, and secondary coverage in the same order
interface Props {
  catalog: ICapabilities;
  group: ICapabilityGroup;
  examples: ICapabilityCase[];
  position: number;
}
const { catalog, group, examples, position } = Astro.props;
---

<section
  id={group.id}
  class="page-shell grid scroll-mt-24 gap-6 border-t py-8 sm:gap-8 sm:py-10 lg:grid-cols-2 lg:items-start lg:gap-x-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,40rem)]"
  aria-labelledby={`${group.id}-heading`}
  data-capability-section
>
  <header class="max-w-lg lg:pt-3">
    <p class="eyebrow mb-3">{String(position).padStart(2, '0')} / {group.label}</p>
    <h2
      id={`${group.id}-heading`}
      class="section-title"
    >
      <InlineBrandText text={group.title} />
    </h2>
    <p class="mt-4 text-base leading-7 text-muted-foreground">
      <InlineBrandText text={group.description} />
    </p>
    <a
      class="mt-4 inline-flex items-center gap-2 text-link text-sm font-medium"
      href={withBase(group.reference.route, import.meta.env.BASE_URL)}
    >
      {group.reference.label}<ArrowUpRight
        class="size-4 shrink-0"
        aria-hidden="true"
      />
    </a>
  </header>
  <div class="min-w-0">
    <div
      id={`${group.id}-examples`}
      class="grid min-w-0 gap-2"
      data-capability-list
    >
      {
        examples.map((example, index) => (
          <CapabilityExample
            {example}
            {catalog}
            position={index + 1}
            total={examples.length}
          />
        ))
      }
    </div>
    <div
      class="mt-5 flex flex-col items-center gap-3"
      data-capability-controls
      hidden
    >
      <p
        class="text-xs text-muted-foreground"
        aria-live="polite"
        aria-atomic="true"
        data-capability-count
      >
      </p>
      <ActionButton
        variant="outline"
        data-capability-load
        aria-label={`Load more ${group.label.toLowerCase()} examples`}
        aria-controls={`${group.id}-examples`}
      >
        Load more <ChevronDown
          class="size-4"
          aria-hidden="true"
        />
      </ActionButton>
    </div>
    <p
      class="mt-4 text-xs leading-6 text-muted-foreground"
      data-capability-coverage={group.id}
    >
      <span class="font-medium text-foreground">Also covers: </span>
      <InlineBrandText text={`${group.coverage.join('; ')}.`} />
    </p>
  </div>
</section>
