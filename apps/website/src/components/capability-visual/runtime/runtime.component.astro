---
import { Unlink } from '@lucide/astro';
import { parse } from 'yaml';
import { z } from 'zod';

import CodeBlock from '@moldea.ai/website-ui/code-block';
import ConnectionLabel from '@moldea.ai/website-ui/connection-label';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import type { ICapabilities, ICapabilityCase } from '../../../lib/capabilities/index.ts';

import { getRuntimeSourcePreviews } from './utilities.ts';

interface Props {
  example: ICapabilityCase;
  catalog: ICapabilities;
}
const { example, catalog } = Astro.props;
if (example.result.kind !== 'adapter')
  throw new Error('Runtime illustration requires an adapter result.');
const { evidence, diagnostics } = example.result;
const isOpenAiConnectionExample =
  example.id === 'openai-responses' || example.id === 'openai-loader-disconnected';

// retain the exact declared-loader illustration for the two original OpenAI stories
const disconnected = isOpenAiConnectionExample
  ? diagnostics.find(({ code }) => code === 'OPENAI_INSTRUCTION_LOADER_NOT_WIRED')
  : undefined;
const LoaderManifest = z.object({
  agents: z.record(
    z.string(),
    z.object({
      bindings: z.object({ instructionLoader: z.object({ path: z.string(), symbol: z.string() }) }),
    }),
  ),
});
const manifest = example.files.find(({ path }) => path === '/moldea/moldea.yaml');
const loader =
  disconnected && manifest
    ? LoaderManifest.parse(parse(manifest.content) as unknown).agents[
        disconnected.entity?.agentId ?? ''
      ]?.bindings.instructionLoader
    : undefined;
if (disconnected && (!loader || !example.files.some(({ path }) => path === loader.path)))
  throw new Error('Disconnected runtime illustration requires its declared loader file.');
const instructionLine = example.files
  .find(({ path }) => path === disconnected?.path)
  ?.content.split('\n')
  .find((line) => line.trim().startsWith('instructions:'))
  ?.trim();
if (disconnected && !instructionLine)
  throw new Error('Disconnected runtime illustration requires the request instruction.');
const request = isOpenAiConnectionExample
  ? evidence.find(({ kind }) => kind === 'runtime-pattern')
  : undefined;
if (isOpenAiConnectionExample && (!request?.runtimeName || !request.references[0]))
  throw new Error('Runtime illustration requires a request reference.');
const connections = isOpenAiConnectionExample
  ? [
      { kind: 'instruction-loader', label: 'Instruction loader' },
      { kind: 'tool-registration', label: 'Order lookup tool' },
    ]
      .filter(() => !disconnected)
      .map(({ kind, label }) => {
        const record = evidence.find((entry) => entry.kind === kind);
        const reference = record?.references.at(-1);
        if (!record?.runtimeName || !reference)
          throw new Error(`Runtime illustration requires ${kind} evidence.`);
        return { label, name: record.runtimeName, path: reference.path };
      })
  : [];

// other runtime examples show witnessed source excerpts and the actual inspection outcome
const diagnostic = diagnostics.find(({ severity }) => severity === 'error') ?? diagnostics[0];
const previews = isOpenAiConnectionExample ? [] : getRuntimeSourcePreviews(example, catalog);
const tone = diagnostic?.severity === 'error' ? 'danger' : diagnostic ? 'warning' : 'info';
const generationMethods =
  example.id === 'google-mixed-generation'
    ? evidence
        .filter(({ kind, runtimeName }) => kind === 'runtime-pattern' && Boolean(runtimeName))
        .map(({ runtimeName }) => runtimeName)
    : [];
---

{
  isOpenAiConnectionExample ? (
    <div
      class="min-w-0"
      role="group"
      aria-label="Connections found in the OpenAI source"
    >
      <FilePreview
        path={request?.references[0]?.path.slice(1) ?? ''}
        label={disconnected ? 'Request uses hard-coded text' : 'OpenAI request'}
      >
        <p class="p-4 text-sm leading-7">
          <code class="inline-code break-words">
            {disconnected ? instructionLine : request?.runtimeName}
          </code>
        </p>
      </FilePreview>
      {!disconnected && (
        <ul class="ml-3 space-y-3 border-l-2 border-info/40 pt-3 pl-4">
          {connections.map((connection) => (
            <li>
              <FilePreview
                path={connection.path.slice(1)}
                label={connection.label}
              >
                <p class="p-3 text-xs">
                  <code class="inline-code">{connection.name}</code>
                </p>
              </FilePreview>
            </li>
          ))}
        </ul>
      )}
      {loader && (
        <>
          <ConnectionLabel tone="danger">
            <Unlink
              slot="icon"
              class="size-4"
              aria-hidden="true"
            />
            Not connected to this loader
          </ConnectionLabel>
          <FilePreview
            path={loader.path.slice(1)}
            label="Declared instruction loader"
            tone="danger"
          >
            <p class="p-4 text-sm">
              <code class="inline-code">{loader.symbol}</code>
            </p>
          </FilePreview>
        </>
      )}
    </div>
  ) : (
    <div
      class="grid min-w-0 gap-3"
      role="group"
      aria-label={`${example.title} source and result`}
    >
      {previews.map((preview, index) => (
        <div class="min-w-0">
          <FilePreview
            path={preview.file.path.slice(1)}
            label={preview.label}
            tone={tone}
          >
            <div class="p-3">
              <CodeBlock
                source={preview.content}
                language={preview.file.language}
                variant="plain"
                copyable={false}
                ariaLabel={`Source excerpt ${index + 1} for ${example.title}`}
              />
            </div>
          </FilePreview>
          {preview.isExcerpt && (
            <p class="mt-2 text-xs text-muted-foreground">
              Showing selected lines of the executed source.
            </p>
          )}
        </div>
      ))}
      {generationMethods.length > 0 && (
        <p class="mt-2 text-xs leading-5 text-muted-foreground">
          Observed source methods: {generationMethods.join(', ')}.
        </p>
      )}
      {diagnostic && (
        <div class="mt-3 flex flex-wrap items-start gap-2 text-xs leading-5">
          <StatusBadge
            label={diagnostic.severity === 'error' ? 'Invalid' : 'Unverified'}
            tone={tone}
            size="sm"
          />
          <p class="min-w-0 flex-1 text-muted-foreground">{diagnostic.message}</p>
        </div>
      )}
    </div>
  )
}
