---
import { Folder } from '@lucide/astro';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import { getCapabilityVisualFiles, type ICapabilityCase } from '../../lib/capabilities/index.ts';
import { CapabilityRecords } from './records/index.ts';
import { CapabilityDecisions } from './decisions/index.ts';

// source is selected from executed inputs, never transcribed for the illustration
interface Props {
  example: ICapabilityCase;
}
const { example } = Astro.props;
const commandHtml =
  example.result.kind === 'cli'
    ? await renderMarkdownFragment(`\`\`\`sh\n${example.result.command}\n\`\`\``)
    : '';
const files = getCapabilityVisualFiles(example);
const renderedFiles = await Promise.all(
  files.map(async (file) => ({
    ...file,
    html: await renderMarkdownFragment(`\`\`\`${file.language}\n${file.content}\n\`\`\``),
  })),
);
---

{
  example.result.kind === 'cli' ? (
    <div class="min-w-0 rounded-lg border bg-muted/30 p-3">
      <p class="mb-2 text-xs text-muted-foreground">Command</p>
      <div
        class="prose-moldea min-w-0 [&_pre]:m-0 [&_pre]:rounded-none [&_pre]:border-0 [&_pre]:bg-transparent [&_pre]:p-0 [&_pre]:pb-1 [&_pre]:text-xs [&_pre]:leading-6"
        set:html={commandHtml}
      />
      <p class="mt-3 border-t pt-2 text-xs text-muted-foreground">
        JSON schema {example.result.schemaVersion} <span class="mx-2">/</span> Exit{' '}
        {example.result.exitStatus}
      </p>
    </div>
  ) : example.groupId === 'decisions' ? (
    <CapabilityDecisions {example} />
  ) : example.id === 'manifest-change-relevance' ? (
    <CapabilityRecords {example} />
  ) : files.length > 0 ? (
    <div class="grid min-w-0 gap-3">
      {renderedFiles.map((file, index) => (
        <FilePreview
          path={file.path.slice(1)}
          label={
            example.id === 'mirror-stale'
              ? index === 0
                ? 'Canonical instruction'
                : 'Declared mirror'
              : file.isExcerpt
                ? 'Executed source excerpt'
                : 'Example file'
          }
        >
          <div
            class="prose-moldea min-w-0 text-xs [&_pre]:m-0 [&_pre]:rounded-none [&_pre]:border-0 [&_pre]:bg-transparent [&_pre]:p-3 [&_pre]:text-xs [&_pre]:leading-6"
            set:html={file.html}
          />
        </FilePreview>
      ))}
      {example.id === 'policy-reference-directory' && example.result.kind === 'validation' && (
        <div class="flex items-center gap-3 rounded-lg border border-warning/60 bg-warning/15 p-3">
          <Folder
            class="size-5 shrink-0"
            aria-hidden="true"
          />
          <div class="min-w-0">
            <p class="mb-1 text-xs text-muted-foreground">Referenced entry: directory</p>
            <code class="text-xs break-all">
              {String(example.result.diagnostics[0].details.referencedPath)}
            </code>
          </div>
        </div>
      )}
    </div>
  ) : (
    <CapabilityRecords {example} />
  )
}
