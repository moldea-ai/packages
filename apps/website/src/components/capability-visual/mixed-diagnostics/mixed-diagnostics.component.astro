---
import { z } from 'zod';

import InspectionFinding from '@moldea.ai/website-ui/inspection-finding';
import { DIAGNOSTIC_GROUP_PRESENTATIONS } from '@moldea.ai/website-ui/inspection-presentation';

import { getCapabilityFactRows, type ICapabilityCase } from '../../../lib/capabilities/index.ts';

// every page and its totals come from one executed Core inspection
interface Props {
  example: ICapabilityCase;
}
const { example } = Astro.props;
if (example.result.kind !== 'inspection')
  throw new Error('Mixed diagnostic illustration requires inspection facts.');
const { counts } = example.result.facts;
if (
  !counts ||
  typeof counts !== 'object' ||
  Array.isArray(counts) ||
  counts.diagnostics !== 3 ||
  counts.errors !== 1 ||
  counts.warnings !== 2
)
  throw new Error('Mixed diagnostic illustration requires complete inspection counts.');
const findingTitles: Record<string, string> = {
  MOLDEA_IMPACT_PATTERN_UNMATCHED: 'No files match the declared relationship',
  MOLDEA_INTEGRATION_BLOCK_MISSING: 'Project setup guidance is missing',
  MOLDEA_REFERENCE_EXPORT_MISSING: 'Declared export missing',
};
const pages = getCapabilityFactRows(example.result.facts.pages);
if (pages.length !== 3) throw new Error('Mixed diagnostic illustration requires three pages.');
const entries = pages.map((page, index) => {
  const [record] = getCapabilityFactRows(page.records);
  if (
    !record ||
    typeof record.code !== 'string' ||
    (record.severity !== 'warning' && record.severity !== 'error') ||
    page.hasContinuation !== index < pages.length - 1
  )
    throw new Error('Mixed diagnostic illustration requires a paginated diagnostic.');
  const group = z
    .enum(['discovery', 'manifest', 'references', 'agents', 'mirrors', 'integration'])
    .parse(record.group);
  const title = findingTitles[record.code];
  if (!title) throw new Error('Mixed diagnostic illustration requires a known finding title.');
  return {
    title,
    page: index + 1,
    code: record.code,
    severity: z.enum(['error', 'warning']).parse(record.severity),
    group,
  };
});
---

<div
  class="min-w-0 space-y-3"
  role="group"
  aria-label="Paginated inspection diagnostics"
>
  <p class="text-sm leading-6">
    Inspection totals: <strong>{counts.diagnostics} diagnostics</strong>, {counts.warnings} warnings and
    {counts.errors} error.
  </p>
  <ol
    class="divide-y rounded-lg border px-3"
    aria-label="Diagnostic pages"
  >
    {
      entries.map((entry) => (
        <li class="min-w-0 py-3">
          <span class="sr-only">Page {entry.page}</span>
          <InspectionFinding
            title={entry.title}
            code={entry.code}
            severity={entry.severity}
            presentation={DIAGNOSTIC_GROUP_PRESENTATIONS[entry.group]}
          />
        </li>
      ))
    }
  </ol>
  <p class="text-xs leading-5 text-muted-foreground">Each page retains the inspection totals.</p>
</div>
