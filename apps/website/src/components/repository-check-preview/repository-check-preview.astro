---
import { FileCodeCorner, FileText } from '@lucide/astro';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import type { IInstructionExample } from '../../lib/instruction-example/index.ts';
import { InspectionResult } from '../inspection-result/index.ts';
import { InspectionSummary } from '../inspection-summary/index.ts';

// a second real Core check complements the moved-file sequence below the hero
interface Props {
  example: IInstructionExample;
}
const { example } = Astro.props;
const instructionHtml = await renderMarkdownFragment(example.instruction);
const instructionPath = example.instructionPath.slice(1);
const instructionFilenameStart = instructionPath.lastIndexOf('/');
---

<figure
  class="min-w-0 border-y bg-background/80 py-5 sm:rounded-2xl sm:border sm:bg-card sm:p-6 sm:shadow-surface"
  aria-label="Repository check preview"
>
  <figcaption class="mb-5 flex min-h-12 items-center gap-3">
    <span class="min-w-0 flex-1 text-base leading-snug font-bold sm:text-lg">
      The instruction is here,<br />but the code is missing.
    </span>
    <InspectionResult
      id="hero-check-result"
      triggerAriaLabel="View result: Hero example"
      result={example.result}
      summary="missing-tool-implementation"
      subjectLabel="Missing implementation"
      subject={example.implementationPath}
    />
  </figcaption>
  <div class="overflow-hidden rounded-lg border">
    <div class="flex items-center gap-3 border-b bg-muted/30 px-3 py-3">
      <FileText
        class="size-5 shrink-0 text-muted-foreground"
        aria-hidden="true"
      />
      <div class="min-w-0 flex-1">
        <p class="mb-1 text-xs text-muted-foreground">Agent instruction</p>
        <code
          class="flex text-xs whitespace-nowrap"
          title={instructionPath}
        >
          <span class="min-w-0 truncate">{instructionPath.slice(0, instructionFilenameStart)}</span
          ><span class="shrink-0">{instructionPath.slice(instructionFilenameStart)}</span>
        </code>
      </div>
    </div>
    <div
      class="prose-moldea p-4 text-sm leading-6 [&_p]:my-0 [&_p+p]:mt-2"
      role="group"
      aria-label="Instruction content"
      set:html={instructionHtml}
    />
  </div>
  <div class="ml-5 flex items-center gap-3 py-2">
    <span
      class="h-7 shrink-0 border-l-2 border-dashed border-destructive/60"
      aria-hidden="true"
    ></span>
    <p class="prose-moldea text-xs leading-5 text-muted-foreground">
      Tool implementation linked in <code>moldea.yaml</code>
    </p>
  </div>
  <div
    class="flex items-center gap-3 rounded-lg border border-dashed border-destructive/50 bg-destructive/5 px-3 py-3"
    role="group"
    aria-label="Missing tool implementation"
  >
    <FileCodeCorner
      class="size-5 shrink-0 text-muted-foreground"
      aria-hidden="true"
    />
    <code class="min-w-0 flex-1 text-sm break-all">{example.implementationPath.slice(1)}</code>
    <StatusBadge
      label="Missing"
      size="sm"
      tone="danger"
    />
  </div>
  <div class="mt-5 border-t border-destructive/30 pt-4">
    <InspectionSummary
      result={example.result}
      summary="missing-tool-implementation"
    />
  </div>
</figure>
