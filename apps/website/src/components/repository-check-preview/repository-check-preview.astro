---
import { FileCodeCorner, FileText } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import { formatRepositoryPath } from '@moldea.ai/website-ui/code-presentation';
import CodeText from '@moldea.ai/website-ui/code-text';
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import FilePreview from '@moldea.ai/website-ui/file-preview';

import type { IInstructionExample } from '../../lib/instruction-example/index.ts';
import { InspectionResult } from '../inspection-result/index.ts';

// a second real Core check complements the moved-file sequence below the hero
// the example's build guard admits only a failing check, so the header states that outcome
interface Props {
  example: IInstructionExample;
}
const { example } = Astro.props;
---

<figure
  class="example-card max-sm:border-y max-sm:bg-background/80 max-sm:py-5"
  aria-label="Repository check preview"
>
  <figcaption class="example-card-header">
    <span class="example-card-title flex-1">
      The instruction is here,<br />but the code is missing.
    </span>
    <span class="shrink-0 pt-px sm:pt-0.5">
      <StatusBadge
        label="Check failed"
        tone="danger"
        size="sm"
      />
    </span>
  </figcaption>
  <FilePreview
    path={example.instructionPath}
    label="Agent instruction"
  >
    <FileText
      slot="icon"
      class="size-5"
      aria-hidden="true"
    />
    <div class="p-4">
      <CodeBlock
        source={example.instruction}
        language="markdown"
        variant="plain"
        copyable={false}
        ariaLabel="Instruction content"
      />
    </div>
  </FilePreview>
  <div class="ml-5 flex items-center gap-3 py-2">
    <span
      class="h-7 shrink-0 border-l-2 border-dashed border-destructive/60"
      aria-hidden="true"
    ></span>
    <p class="prose-moldea text-xs leading-5 text-muted-foreground">
      Tool implementation linked in <code>moldea.yaml</code>
    </p>
  </div>
  <div
    class="flex items-center gap-3 rounded-lg border border-dashed border-destructive/50 bg-destructive/5 px-3 py-3"
    role="group"
    aria-label="Missing tool implementation"
  >
    <FileCodeCorner
      class="size-5 shrink-0 text-muted-foreground"
      aria-hidden="true"
    />
    <CodeText
      class="min-w-0 flex-1 text-sm"
      value={formatRepositoryPath(example.implementationPath)}
    />
    <StatusBadge
      label="Missing"
      size="sm"
      tone="danger"
    />
  </div>
  <div class="example-card-footer">
    <InspectionResult
      id="hero-check"
      result={example.result}
      summary="missing-tool-implementation"
      files={example.files}
    />
  </div>
</figure>
