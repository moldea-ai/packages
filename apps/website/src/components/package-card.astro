---
import { ArrowUpRight, Box, Database, FolderTree, Terminal } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import type { IPublicPackage } from '../lib/model/types.ts';
import type { IPackageDiscoveryCopy } from '../lib/discovery-copy/index.ts';
import AdapterCompanyLogo from './adapter-company-logo.astro';

interface Props {
  adapterId?: string;
  packageModel: IPublicPackage;
  copy: IPackageDiscoveryCopy;
}

const { adapterId, packageModel, copy } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const icons = {
  cli: Terminal,
  core: Box,
  repository: Database,
  'repository-fs': FolderTree,
} as const;
const Icon = icons[packageModel.slug as keyof typeof icons] ?? Box;
---

<a
  class="interactive-card group flex min-w-0 flex-col border-b py-5 sm:rounded-xl sm:border sm:bg-card sm:p-6 sm:shadow-surface"
  href={withBase(packageModel.route, basePath)}
>
  <div class="mb-5 flex items-start justify-between gap-4">
    {
      adapterId ? (
        <AdapterCompanyLogo {adapterId} />
      ) : (
        <span class="inline-flex size-11 items-center justify-center rounded-lg border bg-muted">
          <Icon
            class="size-5"
            aria-hidden="true"
          />
        </span>
      )
    }
    <ArrowUpRight
      class="size-5 text-muted-foreground transition-colors group-hover:text-foreground motion-reduce:transition-none"
      aria-hidden="true"
    />
  </div>
  <h3 class="mb-3 text-xl font-semibold tracking-tight">{copy.name}</h3>
  <p class="mb-3 font-mono text-xs break-all text-muted-foreground">
    <code>{packageModel.name}</code>
  </p>
  <p class="mb-6 leading-6 text-muted-foreground">
    <InlineBrandText text={copy.description} />
  </p>
  <div class="mt-auto flex items-end justify-between gap-3">
    <span class="text-sm font-bold">Explore package</span>
    <span class="shrink-0 font-mono text-xs whitespace-nowrap text-muted-foreground">
      <span class="sr-only">Version </span>v{packageModel.version}
    </span>
  </div>
</a>
