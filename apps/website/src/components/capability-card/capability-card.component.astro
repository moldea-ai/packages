---
import type { ICapabilities, ICapabilityCase } from '../../lib/capabilities/index.ts';
import { CapabilityVisual } from '../capability-visual/index.ts';
import { CapabilityResult } from '../capability-result/index.ts';

// hosts place this inside an example card or a website-ui dialog body, whose insets its footer cancels
interface Props {
  example: ICapabilityCase;
  catalog: ICapabilities;
}
const { example, catalog } = Astro.props;
---

<article
  class="min-w-0"
  aria-labelledby={`example-${example.id}-title`}
>
  <CapabilityVisual
    {example}
    {catalog}
  />
  <div
    class="example-card-footer"
    data-capability-summary={example.id}
  >
    <CapabilityResult {example} />
  </div>
</article>
