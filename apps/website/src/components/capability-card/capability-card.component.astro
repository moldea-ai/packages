---
import { CircleAlert, ScanLine } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import ResultSummary from '@moldea.ai/website-ui/result-summary';
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import {
  getCapabilityOutcome,
  type ICapabilities,
  type ICapabilityCase,
} from '../../lib/capabilities/index.ts';
import { CapabilityVisual } from '../capability-visual/index.ts';
import { CapabilityResult } from '../capability-result/index.ts';

// feature-specific composition of the shared file, summary, status, and dialog primitives
interface Props {
  example: ICapabilityCase;
  catalog: ICapabilities;
  position: number;
  total: number;
}
const { example, catalog, position, total } = Astro.props;
const outcome = getCapabilityOutcome(example, catalog);
const Icon = outcome.tone === 'danger' || outcome.tone === 'warning' ? CircleAlert : ScanLine;
---

<article
  class="flex min-w-0 flex-col gap-4 border-b py-6 last:border-b-0 sm:rounded-xl sm:border sm:bg-card sm:p-5"
  data-capability-outcome={example.id}
  data-capability-label={outcome.label}
  aria-labelledby={`${example.id}-title`}
>
  <header class="min-w-0">
    <p class="mb-2 text-xs text-muted-foreground">Example {position} of {total}</p>
    <h3
      id={`${example.id}-title`}
      tabindex="-1"
      class="scroll-mt-24 rounded-sm text-lg font-semibold tracking-tight outline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-solid"
    >
      <InlineBrandText text={example.title} />
    </h3>
  </header>
  <CapabilityVisual
    {example}
    {catalog}
  />
  <div class="flex flex-col gap-3 border-t pt-4 sm:flex-row sm:items-center sm:justify-between">
    <div
      class="min-w-0 flex-1"
      data-capability-summary={example.id}
    >
      <ResultSummary
        title={outcome.title}
        description=""
        tone={outcome.tone}
      >
        <Icon
          slot="icon"
          class="size-5"
        />
        <span
          slot="status"
          data-capability-status
        >
          <StatusBadge
            label={outcome.label}
            tone={outcome.tone}
            size="sm"
          />
        </span>
      </ResultSummary>
    </div>
    <div class="w-full sm:w-auto">
      <CapabilityResult
        {example}
        {catalog}
      />
    </div>
  </div>
</article>
