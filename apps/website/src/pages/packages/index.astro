---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import PackageCard from '../../components/package-card.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const toolingPackages = model.packages;
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Packages' }];
---

<BaseLayout
  title="Open-source packages"
  description="Explore the public moldea packages for repository access, deterministic Core interpretation, and CLI composition."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="max-w-4xl pt-16 pb-12">
      <p class="eyebrow mb-5">Public package ecosystem</p>
      <h1 class="page-title">One foundation. Explicit responsibilities.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-muted-foreground">
        Start with the CLI to check an adopted repository. Choose Core and repository readers when
        building your own tools.
      </p>
      <a
        class="mt-5 inline-block text-link"
        href={withBase('/getting-started/', import.meta.env.BASE_URL)}
        >Not sure where to start? Read the guide.</a
      >
    </div>

    <section aria-labelledby="tooling-title">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Read-only tools</p>
          <h2
            id="tooling-title"
            class="section-title"
          >
            CLI and libraries
          </h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-muted-foreground">
          The CLI combines these building blocks for local checks. Most users do not need to
          assemble them separately.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          toolingPackages.map((packageModel) => (
            <PackageCard
              packageModel={packageModel}
              copy={model.discoveryCopy.packages[packageModel.name]}
            />
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
