---
import { ArrowDown, ArrowRight, ExternalLink, GitBranch, GitPullRequest } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import CodeDiff from '@moldea.ai/website-ui/code-diff';
import ConnectionLabel from '@moldea.ai/website-ui/connection-label';
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InspectionList from '@moldea.ai/website-ui/inspection-list';
import type { IInspectionResultView } from '@moldea.ai/website-ui/inspection-presentation';
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import { withBase } from '@moldea.ai/website-ui/site';

import { CapabilityCard } from '../../components/capability-card/index.ts';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const guide = model.gettingStarted;
const connectionExample = model.capabilities.cases.find(({ id }) => id === 'cli-invalid-project');
if (!connectionExample) throw new Error('Missing executed CLI connection example.');
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: guide.navigationTitle }];
const sections = [
  { id: 'agent-skill', label: 'Agent Skill' },
  { id: 'local-packages', label: 'Packages' },
  { id: 'cloud', label: 'moldea Cloud' },
  { id: 'pr-assurance', label: 'PR Assurance' },
];
const beforeInstruction = 'Explain eligibility. Never approve refunds.';
const afterInstruction = 'Approve eligible refunds using the order details.';
const supportPolicy =
  'Support can explain the policy and look up orders. It cannot approve refunds or change orders.';
const assuranceIllustration = {
  title: 'Illustrative PR Assurance review',
  label: 'Error',
  tone: 'danger',
  findings: [
    {
      id: 'refund-authority',
      title: 'Refund approval boundary',
      code: 'CONTEXT_CONTRADICTED',
      severity: 'error',
      category: 'context',
      message:
        'The changed instruction allows support to approve refunds, exceeding the authority set by the project rule.',
      path: '/moldea/agents/support/instruction.md',
      evidence: [
        {
          path: '/moldea/project.md',
          label: 'Project rule',
          language: 'markdown',
          content: supportPolicy,
          isExcerpt: true,
        },
        {
          path: '/moldea/agents/support/instruction.md',
          label: 'Changed instruction',
          issueLabel: 'Violates project rule',
          language: 'markdown',
          content: afterInstruction,
          isExcerpt: true,
        },
      ],
    },
  ],
  redactions: [],
  limitation: 'Illustrative review of the displayed rule and instruction.',
} satisfies IInspectionResultView;
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-4xl pt-12 pb-12 sm:pt-16">
      <p class="eyebrow mb-4">The <code class="inline-code normal-case">moldea</code> ecosystem</p>
      <h1 class="page-title">{guide.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">{guide.description}</p>
      <nav
        class="mt-8 flex flex-wrap gap-2"
        aria-label="Explore the ecosystem"
      >
        {
          sections.map(({ id, label }) => (
            <ActionLink
              href={`#${id}`}
              variant="outline"
              size="sm"
            >
              {label}
            </ActionLink>
          ))
        }
      </nav>
    </header>

    <div
      id="adoption-guide"
      class="grid gap-section-gap"
    >
      <section
        id="agent-skill"
        class="grid scroll-mt-24 items-center gap-8 border-t pt-10 lg:grid-cols-2 lg:gap-16"
        aria-labelledby="skill-title"
        data-ecosystem-section
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">01 · Agent Skill</p>
          <h2
            id="skill-title"
            class="section-title"
          >
            Give your coding agent the project context.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Start with the <a
              class="text-link"
              href="https://skill.moldea.ai/"
              target="_blank"
              rel="noopener noreferrer"
              ><code class="inline-code">moldea Agent Skill</code><span class="sr-only">
                (opens in a new tab)</span
              ><ExternalLink
                class="ml-1 inline size-3.5"
                aria-hidden="true"
                data-external-link-icon
              /></a
            >. It captures project knowledge in Git and brings it into your coding agent's work.
          </p>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            Installing a package alone does not adopt the repository. Start with the Skill.
          </p>
          <ActionLink
            class="mt-6"
            href="https://skill.moldea.ai/"
            target="_blank"
            >Start with the Agent Skill</ActionLink
          >
        </div>
        <figure
          class="min-w-0"
          aria-label="Illustrative adoption conversation"
        >
          <figcaption class="eyebrow mb-5">Adopt an existing project</figcaption>
          <Conversation ariaLabel="Adopting project context">
            <ConversationMessage role="user"
              ><p class="text-sm leading-6 font-medium">
                Initialize moldea in this repository.
              </p></ConversationMessage
            >
            <ConversationMessage role="assistant">
              <p class="mb-4 text-sm leading-7">
                Project context is saved. The refund policy is connected to its implementation.
              </p>
              <FilePreview
                path="moldea/project.md"
                label="Project brief"
              >
                <div class="p-4 text-sm leading-7">
                  <p class="font-semibold">Trailside support</p><p
                    class="mt-2 text-muted-foreground"
                  >
                    Support explains the refund policy and looks up orders. The application decides
                    eligibility.
                  </p>
                </div>
              </FilePreview>
              <ConnectionLabel
                ><ArrowDown
                  slot="icon"
                  class="size-4"
                />Connected project knowledge</ConnectionLabel
              >
              <FilePreview
                path="moldea/context/refund-policy.md"
                label="Refund policy"
              />
            </ConversationMessage>
          </Conversation>
        </figure>
      </section>

      <section
        id="local-packages"
        class="grid scroll-mt-24 items-center gap-8 border-t pt-10 lg:grid-cols-2 lg:gap-16"
        aria-labelledby="packages-title"
        data-ecosystem-section
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">02 · Open-source packages</p>
          <h2
            id="packages-title"
            class="section-title"
          >
            Check the connections as your code changes.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            The manifest names an export that the code has renamed. The CLI identifies the binding
            and records a failed export check.
          </p>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            Read-only. No model calls, network requests, or telemetry. These guarantees apply to the
            CLI, not every coding-agent or Agent Skill workflow.
          </p>
          <ActionLink
            class="mt-5"
            href={withBase('/packages/cli/', import.meta.env.BASE_URL)}
            variant="link"
            >CLI overview and installation guide<ArrowRight
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          >
          <p class="mt-5 text-sm leading-7 text-muted-foreground">
            Core checks structure, Repository and Repository FS supply snapshots, and the CLI brings
            them together locally. Code behavior needs separate evaluation.
          </p>
          <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm">
            <a
              class="text-link"
              href={withBase('/packages/core/', import.meta.env.BASE_URL)}
              >Core</a
            >
            <a
              class="text-link"
              href={withBase('/packages/repository/', import.meta.env.BASE_URL)}
              >Repository</a
            >
            <a
              class="text-link"
              href={withBase('/packages/repository-fs/', import.meta.env.BASE_URL)}
              >Repository FS</a
            >
          </p>
        </div>
        <figure
          aria-labelledby={`example-${connectionExample.id}-title`}
          class="min-w-0 sm:rounded-2xl sm:border sm:bg-card sm:p-6"
        >
          <figcaption class="mb-6">
            <h3
              id={`example-${connectionExample.id}-title`}
              class="flex items-start gap-2 text-lg font-semibold"
            >
              <GitPullRequest
                class="mt-1 size-5 shrink-0"
                aria-hidden="true"
              />
              {connectionExample.title}
            </h3>
          </figcaption>
          <CapabilityCard
            example={connectionExample}
            catalog={model.capabilities}
          />
        </figure>
      </section>

      <section
        id="cloud"
        class="grid scroll-mt-24 items-center gap-8 border-t pt-10 lg:grid-cols-2 lg:gap-16"
        aria-labelledby="cloud-title"
        data-ecosystem-section
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">03 · <code class="inline-code normal-case">moldea Cloud</code></p>
          <h2
            id="cloud-title"
            class="section-title"
          >
            Review with the same project knowledge.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Bring project context, decisions, and review evidence together. Your team shares the
            same Git-owned knowledge used during development.
          </p>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            Cloud review is in development. The Skill and packages work locally without it.
          </p>
          <ActionLink
            class="mt-6"
            href="https://moldea.ai"
            target="_blank"
            >Explore moldea Cloud</ActionLink
          >
        </div>
        <figure
          class="min-w-0 sm:rounded-2xl sm:border sm:bg-card sm:p-6"
          aria-label="Illustrative Cloud project context"
        >
          <figcaption class="mb-5 flex items-center gap-3 text-sm font-semibold">
            <GitBranch
              class="size-5"
              aria-hidden="true"
            />Project context in Git<StatusBadge
              label="Illustrative"
              tone="neutral"
              size="sm"
            />
          </figcaption>
          <FilePreview
            path="moldea/project.md"
            label="Who owns the decision?"
          >
            <p class="p-4 text-sm leading-7">
              Support can explain the policy and look up orders. It cannot approve refunds or change
              orders.
            </p>
          </FilePreview>
          <ConnectionLabel
            ><ArrowDown
              slot="icon"
              class="size-4"
            />Shared project rules</ConnectionLabel
          >
          <FilePreview
            path="moldea/context/refund-policy.md"
            label="What is the rule?"
          >
            <p class="p-4 text-sm leading-7">
              Customers may request a refund within <strong>14 completed days</strong> of purchase.
            </p>
          </FilePreview>
        </figure>
      </section>

      <section
        id="pr-assurance"
        class="grid scroll-mt-24 items-start gap-8 border-t pt-10 lg:grid-cols-2 lg:gap-16"
        aria-labelledby="assurance-title"
        data-ecosystem-section
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">04 · PR Assurance</p>
          <h2
            id="assurance-title"
            class="section-title"
          >
            Catch a change that breaks project intent.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Review changes against project rules. Here, a new instruction lets support approve
            refunds, exceeding its authority.
          </p>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            PR Assurance is in development. This illustrates semantic review, beyond structural
            checks.
          </p>
          <ActionLink
            class="mt-6"
            href="https://moldea.ai/pr-assurance"
            target="_blank"
            >Explore PR Assurance</ActionLink
          >
        </div>
        <figure
          class="grid min-w-0 gap-5 sm:rounded-2xl sm:border sm:bg-card sm:p-6"
          aria-label="Illustrative PR Assurance review"
        >
          <figcaption class="flex items-center gap-3 text-sm font-semibold">
            <GitPullRequest
              class="size-5"
              aria-hidden="true"
            />Let support approve refunds<StatusBadge
              label="Illustrative"
              tone="neutral"
              size="sm"
            />
          </figcaption>
          <FilePreview
            path="/moldea/project.md"
            label="Project rule"
          >
            <p class="p-4 text-sm leading-7">{supportPolicy}</p>
          </FilePreview>
          <FilePreview
            path="/moldea/agents/support/instruction.md"
            label="Changed support instruction"
            tone="danger"
          >
            <CodeDiff
              oldValue={beforeInstruction}
              newValue={afterInstruction}
              language="markdown"
              variant="plain"
              ariaLabel="Changed support instruction"
            />
          </FilePreview>
          <div class="border-t pt-4">
            <InspectionList
              id="assurance-illustration"
              result={assuranceIllustration}
            />
          </div>
        </figure>
      </section>
    </div>

    <nav
      class="mt-section-gap grid gap-6 border-t pt-8 sm:grid-cols-2"
      aria-label="Continue with the repository model"
    >
      <div>
        <h2 class="text-lg font-semibold">Understand the project files.</h2><p
          class="mt-3 text-sm leading-7 text-muted-foreground"
        >
          Start with <code class="inline-code">moldea.yaml</code> and <code class="inline-code"
            >project.md</code
          >. Add context, decisions, and agents as needed.
        </p><ActionLink
          class="mt-3"
          href={withBase('/repository-format/', import.meta.env.BASE_URL)}
          variant="link"
          >Repository Format specification<ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
      </div>
      <div>
        <h2 class="text-lg font-semibold">Connect a runtime when you need one.</h2><p
          class="mt-3 text-sm leading-7 text-muted-foreground"
        >
          A runtime ID selects guidance for your coding agent. Core's file and export coverage does
          not establish runtime wiring or SDK compatibility.
        </p><ActionLink
          class="mt-3"
          href={withBase('/runtimes/', import.meta.env.BASE_URL)}
          variant="link"
          >Runtime labels and guidance<ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
      </div>
    </nav>
  </section>
</BaseLayout>
