---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { renderMarkdownDocument } from '@moldea.ai/website-ui/markdown';

import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const { gettingStarted: guide } = loadWebsiteModel();
const rendered = await renderMarkdownDocument(guide.markdown, {
  basePath: import.meta.env.BASE_URL,
  productNameTreatment: 'code',
});
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: guide.navigationTitle }];
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-3xl pt-10 pb-8 sm:pt-16">
      <p class="eyebrow mb-4">Choose your starting point</p>
      <h1 class="page-title">
        <InlineBrandText text={guide.title} />
      </h1>
      <p class="mt-6 text-lg leading-8 text-muted-foreground">{guide.description}</p>
    </header>
    <div
      class="prose-moldea max-w-3xl"
      set:html={rendered.html}
    />
  </section>
</BaseLayout>
