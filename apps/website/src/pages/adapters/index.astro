---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCard from '../../components/adapter-card.astro';
import TargetMaturityLegend from '../../components/target-maturity-legend.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const available = model.adapters.filter(({ entry }) => entry.implementationStatus === 'available');
const upcoming = model.adapters.filter(({ entry }) => entry.implementationStatus !== 'available');
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Runtime Adapters' }];
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Runtime adapters"
  description="Official moldea runtime adapters with technical implementation status, website-owned target maturity, evidence, patterns, and limitations."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="max-w-4xl pt-16 pb-12">
      <p class="eyebrow mb-5">Official runtime inventory</p>
      <h1 class="section-title font-semibold">Runtime knowledge, without runtime execution.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-muted-foreground">
        Find your runtime, then check its supported versions and source patterns. Adapters inspect
        code without executing it. Implementation availability and the maturity of each exact target
        are separate facts.
      </p>
      <a
        class="mt-7 inline-flex items-center gap-2 font-bold"
        href={withBase('/compatibility/', basePath)}
      >
        View the complete compatibility matrix
      </a>
    </div>

    <TargetMaturityLegend />

    <section aria-labelledby="available-adapters-title">
      <div class="mb-7">
        <p class="eyebrow mb-3">Implemented now</p>
        <h2
          id="available-adapters-title"
          class="text-3xl font-semibold tracking-tight"
        >
          Available adapters
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          available.map((adapter) => (
            <AdapterCard
              {adapter}
              copy={model.discoveryCopy.adapters[adapter.id]}
            />
          ))
        }
      </div>
    </section>

    {
      upcoming.length > 0 && (
        <section
          class="mt-section-gap"
          aria-labelledby="planned-adapters-title"
        >
          <div class="mb-7">
            <p class="eyebrow mb-3">Matrix-approved inventory</p>
            <h2
              id="planned-adapters-title"
              class="text-3xl font-semibold tracking-tight"
            >
              Planned and evolving
            </h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((adapter) => (
              <AdapterCard
                {adapter}
                copy={model.discoveryCopy.adapters[adapter.id]}
              />
            ))}
          </div>
        </section>
      )
    }

    <p class="mt-6 text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>
  </section>
</BaseLayout>
