---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import { AdapterRow } from '../../components/adapter-row/index.ts';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const available = model.adapters.filter(({ entry }) => entry.implementationStatus === 'available');
const upcoming = model.adapters.filter(({ entry }) => entry.implementationStatus !== 'available');
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Runtime Adapters' }];
---

<BaseLayout
  title="Runtime adapters and compatibility"
  description="Find your runtime, compare target maturity, and check exact versions, recognized source patterns, limitations, and qualification evidence."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-4xl pt-8 pb-8 sm:pt-10">
      <p class="eyebrow mb-5">Runtime adapters & compatibility</p>
      <h1 class="section-title text-3xl leading-tight font-semibold sm:text-4xl lg:text-5xl">
        Runtime knowledge, without runtime execution.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
        Choose the runtime you use, then the code pattern you want to inspect. Adapters read source
        code; they do not run your agent.
      </p>
    </header>

    <section aria-labelledby="available-adapters-title">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2
          id="available-adapters-title"
          class="text-xl font-semibold"
        >
          Available adapters
        </h2>
      </div>
      <p class="mb-5 text-sm leading-6 text-muted-foreground">
        Targets are supported within their published scope unless marked otherwise. Open a target
        for exact versions, limitations, and qualification evidence.
      </p>
      <ul
        class="divide-y border-y"
        aria-label="Available adapters"
      >
        {
          available.map((adapter) => (
            <li>
              <AdapterRow
                {adapter}
                copy={model.discoveryCopy.adapters[adapter.id]}
              />
            </li>
          ))
        }
      </ul>
    </section>

    {
      upcoming.length > 0 && (
        <section
          class="mt-10"
          aria-labelledby="planned-adapters-title"
        >
          <h2
            id="planned-adapters-title"
            class="mb-4 text-xl font-semibold"
          >
            Planned and evolving
          </h2>
          <ul
            class="divide-y border-y"
            aria-label="Planned and evolving adapters"
          >
            {upcoming.map((adapter) => (
              <li>
                <AdapterRow
                  {adapter}
                  copy={model.discoveryCopy.adapters[adapter.id]}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-8 max-w-3xl text-sm leading-7 text-muted-foreground">
      The same compatibility data is available as the{' '}
      <a
        class="text-link"
        href={withBase('/compatibility/runtimes.json', import.meta.env.BASE_URL)}
        target="_blank"
        rel="noopener noreferrer"
        >machine-readable compatibility JSON</a
      >.
    </p>
    <p class="mt-5 text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>
  </section>
</BaseLayout>
