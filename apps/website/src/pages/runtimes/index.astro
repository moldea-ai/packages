---
import Accordion from '@moldea.ai/website-ui/accordion';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import RuntimeGrid from '@moldea.ai/website-ui/runtime-grid';
import { withBase } from '@moldea.ai/website-ui/site';

import { CapabilityCard } from '../../components/capability-card/index.ts';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const connected = model.capabilities.cases.find(({ id }) => id === 'runtime-guidance-present');
const missing = model.capabilities.cases.find(({ id }) => id === 'runtime-guidance-missing');
if (!connected || !missing) throw new Error('Missing executed runtime guidance examples.');
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Runtimes' }];
---

<BaseLayout
  title="Runtime guidance"
  description="Choose a runtime ID, connect project guidance, and see what Core checks."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="grid items-center gap-10 pt-12 pb-14 lg:grid-cols-2 lg:gap-16">
      <header>
        <p class="eyebrow mb-5">Runtime guidance</p>
        <h1 class="page-title">Guidance for the runtime you use.</h1>
        <p class="mt-7 text-xl leading-9 text-muted-foreground">
          Declare your runtime in the manifest. Your coding agent uses that label and the installed
          SDK's types to review how your application connects instructions and tools.
        </p>
        <p class="mt-5 text-sm leading-7 text-muted-foreground">
          This support agent selects OpenAI and adds a project-owned guidance document. The example
          runs through Core during the website build.
        </p>
      </header>
      <section
        aria-labelledby={`example-${connected.id}-title`}
        class="example-card"
      >
        <h2
          id={`example-${connected.id}-title`}
          class="example-card-header example-card-title"
        >
          {connected.title}
        </h2>
        <CapabilityCard
          example={connected}
          catalog={model.capabilities}
        />
      </section>
    </div>
    <h2 class="section-title mb-3">Find your runtime.</h2>
    <p class="mb-6 max-w-2xl leading-7 text-muted-foreground">
      Use the ID shown below in your manifest. Each link opens the runtime's official website or
      repository.
    </p>
    <RuntimeGrid />
    <p class="mt-5 text-xs leading-6 text-muted-foreground">
      Names and marks belong to their respective owners. Labels do not imply SDK compatibility,
      certification, or vendor endorsement.
    </p>

    <section
      class="mt-section-gap grid items-start gap-10 border-t pt-section-gap lg:grid-cols-2 lg:gap-16"
      aria-labelledby="runtime-checks-title"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-4">Core checks</p>
        <h2
          id="runtime-checks-title"
          class="section-title"
        >
          A declared document must exist.
        </h2>
        <p class="mt-6 leading-8 text-muted-foreground">
          Remove the OpenAI guidance file from the same repository and Core reports the broken
          reference. An empty guidance file also produces an error.
        </p>
        <p class="mt-5 leading-8 text-muted-foreground">
          Core does not check runtime wiring or SDK behavior. Your coding agent reviews those
          connections using the installed SDK and your project context.
        </p>
        <div class="mt-6">
          <Accordion
            id="runtime-check-boundaries"
            title="What else do the checks cover?"
          >
            <div class="grid gap-4 text-sm leading-7 text-muted-foreground">
              <p>
                Core also checks declared code files and explicit TypeScript and JavaScript ESM
                exports. Coverage records say which checks ran and why an export could not be
                checked.
              </p>
              <p>
                A missing export is an error only when the file's export list is complete. CommonJS,
                unresolved exports, malformed source, and per-file resource limits leave the export
                not checked. Interrupted inspections fail the operation.
              </p>
              <p>
                Accepted warnings retain their identity and recorded reason. They do not turn an
                unchecked export into a passed check.
              </p>
              <a
                class="text-link"
                href={withBase('/packages/core/repository-inspection/', import.meta.env.BASE_URL)}
                >Read the coverage contract</a
              >
            </div>
          </Accordion>
        </div>
        <p class="mt-5 text-sm leading-7 text-muted-foreground">
          For another runtime, use <code class="inline-code">custom</code> and add your project's guidance.
        </p>
      </div>
      <section
        aria-labelledby={`example-${missing.id}-title`}
        class="example-card"
      >
        <h3
          id={`example-${missing.id}-title`}
          class="example-card-header example-card-title"
        >
          {missing.title}
        </h3>
        <CapabilityCard
          example={missing}
          catalog={model.capabilities}
        />
      </section>
    </section>
  </section>
</BaseLayout>
