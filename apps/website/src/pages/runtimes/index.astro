---
import RuntimeGrid from '@moldea.ai/website-ui/runtime-grid';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';

const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="SDK guidance"
  description="Find SDKs moldea works with and connect the implementation in your repository."
  breadcrumbs={[{ href: '/', label: 'Home' }, { label: 'SDK guidance' }]}
>
  <section class="page-shell py-12 sm:py-16">
    <header class="mb-8 max-w-3xl">
      <h1 class="page-title">SDKs moldea works with</h1>
      <p class="mt-4 text-lg leading-8 text-muted-foreground">
        Find the SDK your code uses and open its official documentation. Use the installed SDK types
        and application code when connecting an agent’s instructions, schemas, and tools.
      </p>
    </header>
    <RuntimeGrid />
  </section>

  <section class="page-shell border-t border-border py-10 sm:py-14">
    <h2 class="section-title">Connect your implementation</h2>
    <p class="mt-3 max-w-3xl text-muted-foreground">
      Manifest bindings connect an agent to the files and exports that define it. Core checks those
      declared files and supported export syntax. Use application tests to verify how the SDK loads
      instructions, routes work, and registers tools.
    </p>
    <div class="mt-5">
      <a
        class="text-link"
        href={withBase('/repository-format/#repository-references-and-bindings', basePath)}
      >
        Read the binding contract
      </a>
    </div>
  </section>
</BaseLayout>
