---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import LocalSearch from '@moldea.ai/website-ui/local-search';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';

const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Search' }];
const basePath = import.meta.env.BASE_URL;
const searchIndexUrl = withBase('/search-index.json', basePath);
---

<BaseLayout
  title="Search documentation"
  description="Search public moldea package documentation, deterministic capabilities, and runtime adapters locally with no hosted service."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="mx-auto max-w-4xl pt-16">
      <p class="eyebrow mb-5">Local static search</p>
      <h1 class="page-title">Find the contract, not a copy.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        Search package-owned documentation, executable capability examples, and runtime adapters.
        The index is generated from repository sources and sends no query to a hosted service.
      </p>

      <LocalSearch
        action={withBase('/search/', basePath)}
        failureMessage="The local search index could not be loaded. Use package navigation instead."
        initialPrompt="Enter a package, capability, API symbol, or adapter ID."
        noResultsMessage="No matching documentation, capability, or adapter was found."
        placeholder="e.g. repository snapshots"
        {searchIndexUrl}
        shouldFocusOnLoad
      />

      <noscript>
        <div class="mt-8 rounded-xl border bg-accent p-5 leading-7 text-accent-foreground">
          Interactive search requires JavaScript. All documentation remains available through the <a
            class="text-link"
            href={withBase('/packages/', basePath)}
            >package</a
          >,
          <a
            class="text-link"
            href={withBase('/capabilities/', basePath)}
            >capability</a
          >, and <a
            class="text-link"
            href={withBase('/adapters/', basePath)}
            >adapter</a
          > navigation.
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>
