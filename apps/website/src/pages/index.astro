---
import { ArrowRight, ExternalLink, FileCheckCorner, GitBranch, ScanSearch } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCard from '../components/adapter-card.astro';
import { InspectionExample } from '../components/inspection-example/index.ts';
import PackageCard from '../components/package-card.astro';
import { RepositoryCheckPreview } from '../components/repository-check-preview/index.ts';
import { RepositoryFormatOverview } from '../components/repository-format-overview/index.ts';
import BaseLayout from '../layouts/base-layout.astro';
import { loadWebsiteModel } from '../lib/generation/generation.ts';

const model = loadWebsiteModel();
const toolingPackages = model.packages.filter(({ family }) => family === 'skill-core-tooling');
const availableAdapters = model.adapters.filter(
  ({ entry }) => entry.implementationStatus === 'available',
);
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Keep agent instructions and code connected"
  description="Open-source tools for Git-owned project knowledge, declared connections to code, and repeatable structural checks."
  flushFooter
>
  <section
    class="relative overflow-hidden border-b border-border bg-background"
    aria-label="Introduction"
  >
    <div
      class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle_at_70%_18%,color-mix(in_oklch,var(--accent)_60%,transparent),transparent_30%),linear-gradient(to_right,color-mix(in_oklch,var(--border)_35%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklch,var(--border)_35%,transparent)_1px,transparent_1px)] [mask-image:linear-gradient(to_bottom,black,transparent_92%)] [background-size:auto,3rem_3rem,3rem_3rem] opacity-60"
      aria-hidden="true"
    >
    </div>
    <div class="page-shell relative py-12 sm:py-16 lg:py-20">
      <ul
        class="mb-8 flex flex-wrap gap-2"
        aria-label="Package foundations"
      >
        <li
          class="inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1.5 text-xs font-medium"
        >
          <GitBranch
            class="size-3.5 text-muted-foreground"
            aria-hidden="true"
          />Git-owned knowledge
        </li>
        <li
          class="inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1.5 text-xs font-medium"
        >
          <FileCheckCorner
            class="size-3.5 text-muted-foreground"
            aria-hidden="true"
          />Repeatable checks
        </li>
        <li
          class="inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1.5 text-xs font-medium"
        >
          <ScanSearch
            class="size-3.5 text-muted-foreground"
            aria-hidden="true"
          />Precise diagnostics
        </li>
      </ul>
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-12">
        <div class="min-w-0">
          <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl xl:text-6xl">
            Keep agent instructions and code connected.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
            Open-source tools that connect project knowledge to the code it describes. Keep both in
            Git and catch broken connections as your repository changes.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <ActionLink
              href="#how-it-works"
              size="lg"
              >See how it works <ArrowRight
                class="size-4"
                aria-hidden="true"
              /></ActionLink
            >
            <ActionLink
              href={withBase('/getting-started/', basePath)}
              size="lg"
              variant="outline"
              >Start using the tools</ActionLink
            >
          </div>
          <p class="mt-5 text-sm leading-7 text-muted-foreground">
            Want help adopting <InlineBrandText text="moldea" /> in your coding agent? <a
              class="text-link"
              href="https://skill.moldea.ai/"
              target="_blank"
              rel="noopener noreferrer"
              >Explore the Agent Skill</a
            >.
          </p>
        </div>
        <RepositoryCheckPreview example={model.instructionExample} />
      </div>
    </div>
  </section>

  <InspectionExample states={model.inspectionExample} />
  <RepositoryFormatOverview
    repositoryFormatRoute={model.repositoryFormatSpecification.route}
    result={model.inspectionExample[1].result}
  />

  <section
    class="border-y bg-sidebar py-12 sm:py-16"
    aria-labelledby="tools-title"
  >
    <div class="page-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="eyebrow mb-4">Tools by job</p><h2
            id="tools-title"
            class="section-title font-semibold"
          >
            Start with the task.
          </h2>
        </div>
        <ActionLink
          href={withBase('/packages/', basePath)}
          variant="link"
          >View all packages <ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          toolingPackages.map((packageModel) => (
            <PackageCard
              {packageModel}
              copy={model.discoveryCopy.packages[packageModel.name]}
            />
          ))
        }
      </div>
      <p class="mt-7 max-w-4xl text-sm leading-7 text-muted-foreground">
        For an adopted local repository, the CLI is the usual entry point. It already combines a
        filesystem reader, Core, and runtime adapters. Use the libraries directly when you are
        building your own integration.
      </p>
    </div>
  </section>

  <section
    class="page-shell py-12 sm:py-16"
    aria-labelledby="available-adapters-title"
  >
    <header class="mb-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">Runtime-specific evidence</p><h2
          id="available-adapters-title"
          class="section-title text-3xl leading-tight font-semibold sm:text-4xl lg:text-5xl"
        >
          Find your runtime.
        </h2>
      </div>
      <p class="text-lg leading-8 text-muted-foreground">
        Choose your runtime. Check the exact versions and code patterns its adapter can inspect.
      </p>
    </header>
    <ul
      class="grid gap-x-4 sm:grid-cols-2 sm:gap-y-4 lg:grid-cols-3"
      aria-label="Available runtimes"
    >
      {
        availableAdapters.map((adapter) => (
          <li class="min-w-0">
            <AdapterCard
              {adapter}
              copy={model.discoveryCopy.adapters[adapter.id]}
            />
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-5">
      <ActionLink
        href={withBase('/adapters/', basePath)}
        variant="link"
        >View all adapters <ArrowRight
          class="size-4"
          aria-hidden="true"
        /></ActionLink
      >
    </div>
    <p class="mt-5 text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>
  </section>

  <section
    class="border-t bg-sidebar py-12 sm:py-16"
    aria-labelledby="boundaries-title"
  >
    <div class="page-shell">
      <div>
        <p class="eyebrow mb-4">Open source. Explicit boundaries.</p><h2
          id="boundaries-title"
          class="section-title font-semibold"
        >
          Know what a check tells you.
        </h2>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-12">
        <div class="border-t-2 border-foreground pt-5">
          <h3 class="text-xl font-semibold">Facts the tools can establish</h3>
          <ul class="mt-5 divide-y text-base leading-7">
            <li class="py-3">Your repository follows the declared format.</li>
            <li class="py-3">A referenced file exists at its declared path.</li>
            <li class="py-3">An adapter recognizes a published code pattern.</li>
          </ul>
        </div>
        <div class="border-t-2 border-border pt-5">
          <h3 class="text-xl font-semibold">Questions a passing check cannot answer</h3>
          <p class="mt-5 text-xl leading-8">Does the code actually enforce manager approval?</p>
          <p class="mt-4 text-base leading-7 text-muted-foreground">
            Does an agent follow its instructions in practice? Those questions need semantic
            evaluation and behavior testing, beyond these structural checks.
          </p>
        </div>
      </div>
      <div class="mt-8 border-t pt-6 leading-7 text-muted-foreground">
        <p class="max-w-3xl">
          <strong class="text-foreground">Local and read-only.</strong> The CLI makes no model calls or
          network requests and sends no telemetry. The source is MIT licensed. Hosted Cloud services and
          semantic Assurance are separate products.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <ActionLink href={withBase('/getting-started/', basePath)}
            >Get started <ArrowRight
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          ><ActionLink
            href="https://skill.moldea.ai/"
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            >Agent Skill <ExternalLink
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          >
        </div>
        <a
          class="mt-4 inline-block text-link text-sm"
          href="https://github.com/moldea-ai/packages"
          target="_blank"
          rel="noopener noreferrer"
          >Inspect the source on GitHub</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
