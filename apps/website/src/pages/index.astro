---
import { ArrowRight, ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../components/adapter-company-logo.astro';
import { InspectionExample } from '../components/inspection-example/index.ts';
import PackageCard from '../components/package-card.astro';
import { RepositoryFormatOverview } from '../components/repository-format-overview/index.ts';
import BaseLayout from '../layouts/base-layout.astro';
import { loadWebsiteModel } from '../lib/generation/generation.ts';

const model = loadWebsiteModel();
const toolingPackages = model.packages.filter(({ family }) => family === 'skill-core-tooling');
const availableAdapters = model.adapters.filter(
  ({ entry }) => entry.implementationStatus === 'available',
);
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Keep agent instructions and code connected"
  description="Open-source tools for Git-owned project knowledge, declared connections to code, and repeatable structural checks."
>
  <section class="border-b border-border">
    <div class="page-shell py-12 sm:py-16 lg:py-20">
      <p class="eyebrow mb-6">moldea packages / Open source</p>
      <h1
        class="max-w-5xl text-4xl leading-tight font-semibold tracking-tight sm:text-5xl lg:text-6xl"
      >
        The open-source foundation for keeping agent instructions and code aligned.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground sm:text-xl">
        Keep project knowledge in Git, declare its connections to code, and run repeatable
        structural checks as the repository changes. Developers get precise diagnostics. Everyone
        gets a shared record of what the project is meant to do.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ActionLink
          href="#how-it-works"
          size="lg"
          >See how it works <ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
        <ActionLink
          href={withBase('/getting-started/', basePath)}
          size="lg"
          variant="outline"
          >Start using the tools</ActionLink
        >
      </div>
      <p class="mt-5 text-sm leading-7 text-muted-foreground">
        Want help adopting <code>moldea</code> in your coding agent? <a
          class="font-semibold text-foreground underline underline-offset-4"
          href="https://skill.moldea.ai/"
          target="_blank"
          rel="noopener noreferrer"
          >Explore the Agent Skill</a
        >.
      </p>
    </div>
  </section>

  <InspectionExample states={model.inspectionExample} />
  <RepositoryFormatOverview repositoryFormatRoute={model.repositoryFormatSpecification.route} />

  <section
    class="border-y bg-sidebar py-12 sm:py-16"
    aria-labelledby="tools-title"
  >
    <div class="page-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="eyebrow mb-4">Tools by job</p><h2
            id="tools-title"
            class="section-title font-semibold"
          >
            Start with the task.
          </h2>
        </div>
        <ActionLink
          href={withBase('/packages/', basePath)}
          variant="link"
          >View all packages <ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          toolingPackages.map((packageModel) => (
            <PackageCard
              {packageModel}
              copy={model.discoveryCopy.packages[packageModel.name]}
            />
          ))
        }
      </div>
      <p class="mt-7 max-w-4xl text-sm leading-7 text-muted-foreground">
        For an adopted local repository, the CLI is the usual entry point. It already combines a
        filesystem reader, Core, and runtime adapters. Use the libraries directly when you are
        building your own integration.
      </p>
    </div>
  </section>

  <section
    class="page-shell py-12 sm:py-16"
    aria-labelledby="available-adapters-title"
  >
    <div class="mb-8 grid gap-5 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">Runtime-specific evidence</p><h2
          id="available-adapters-title"
          class="section-title max-w-2xl font-semibold"
        >
          Find your runtime.<br />Check its exact scope.
        </h2>
      </div>
      <p class="max-w-xl leading-7 text-muted-foreground">
        Adapters recognize supported source patterns without running your application. Each runtime
        has explicit versions, targets, limitations, and qualification evidence. A runtime name
        alone is not a blanket compatibility claim.
      </p>
    </div>
    <ul
      class="grid divide-y border-y sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-3"
      aria-label="Available runtimes"
    >
      {
        availableAdapters.map((adapter) => (
          <li class="min-w-0">
            <a
              class="flex h-full items-center gap-4 py-5 pr-4 hover:bg-muted sm:px-4"
              href={withBase(adapter.route, basePath)}
            >
              <>
                <AdapterCompanyLogo
                  adapterId={adapter.id}
                  compact
                />
                <span class="min-w-0">
                  <span class="block font-semibold">
                    {model.discoveryCopy.adapters[adapter.id].name}
                  </span>
                  <span class="mt-1 block font-mono text-xs break-all text-muted-foreground">
                    {adapter.id}
                  </span>
                  {adapter.entry.implementation.kind === 'built-in' && (
                    <span class="mt-1 block text-xs text-muted-foreground">Built into Core</span>
                  )}
                </span>
              </>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-5">
      <ActionLink
        href={withBase('/adapters/', basePath)}
        variant="link"
        >View all adapters <ArrowRight
          class="size-4"
          aria-hidden="true"
        /></ActionLink
      ><ActionLink
        href={withBase('/compatibility/', basePath)}
        variant="link"
        >Complete compatibility matrix</ActionLink
      >
    </div>
    <p class="mt-5 text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>
  </section>

  <section
    class="border-t bg-sidebar py-12 sm:py-16"
    aria-labelledby="boundaries-title"
  >
    <div class="page-shell grid gap-8 lg:grid-cols-2">
      <div>
        <p class="eyebrow mb-4">Open source. Explicit boundaries.</p><h2
          id="boundaries-title"
          class="section-title font-semibold"
        >
          Know what a check tells you.
        </h2>
      </div>
      <div class="space-y-5 leading-7 text-muted-foreground">
        <p>
          These packages validate structure and collect runtime-specific evidence. A passing check
          does not prove that code follows an instruction or that an agent behaves correctly.
        </p>
        <p>
          The local CLI is read-only: no model calls, network requests, or telemetry. Agent-assisted
          adoption and workflows belong to the separate Agent Skill.
        </p>
        <p>
          The source is MIT licensed and available for inspection. Hosted Cloud services, semantic
          Assurance, and a future client SDK are not capabilities of these packages.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <ActionLink href={withBase('/getting-started/', basePath)}
            >Get started <ArrowRight
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          ><ActionLink
            href="https://skill.moldea.ai/"
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            >Agent Skill <ExternalLink
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          >
        </div>
        <a
          class="inline-block text-sm font-semibold text-foreground underline underline-offset-4"
          href="https://github.com/moldea-ai/packages"
          target="_blank"
          rel="noopener noreferrer"
          >Inspect the source on GitHub</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
