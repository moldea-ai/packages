{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@moldea.ai/packages-website#clean:build": {
      "cache": false,
      "inputs": ["scripts/clean-build/**"],
      "outputs": []
    },
    "@moldea.ai/packages-website#build": {
      "dependsOn": ["^build", "clean:build"],
      "outputs": ["dist/**", ".generated/model.json"],
      "env": ["SITE_URL", "BASE_PATH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/specifications/repository-format.md",
        "$TURBO_ROOT$/projects/*/package.json",
        "$TURBO_ROOT$/projects/*/docs/**/*.md",
        "$TURBO_ROOT$/projects/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/**/_archive/**",
        "!$TURBO_ROOT$/**/_archives/**",
        "!$TURBO_ROOT$/**/_backup/**",
        "!$TURBO_ROOT$/**/_backups/**"
      ]
    },
    "@moldea.ai/packages-website#test:integration": {
      "dependsOn": ["build", "^test:integration"],
      "env": ["SITE_URL", "BASE_PATH"]
    },
    "@moldea.ai/packages-website#test:e2e": {
      "dependsOn": ["build", "^build"],
      "env": ["PLAYWRIGHT_BROWSERS_PATH", "SITE_URL", "BASE_PATH"]
    },
    "@moldea.ai/website-ui#test:integration": {
      "dependsOn": ["build", "^test:integration"],
      "env": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "@moldea.ai/core#typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "@moldea.ai/repository#typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "@moldea.ai/repository-fs#typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "@moldea.ai/website-ui#typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs:check": {
      "cache": false
    },
    "docs:generate": {
      "cache": false,
      "outputs": [".generated/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "env": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:integration": {
      "dependsOn": ["build", "^test:integration"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    }
  }
}
