          "path": "/moldea/agents/alpha/instruction.md",
          "pointer": null,
          "range": null
        }
      ]
    },
    {
      "name": "literal brace pairs in description and instruction",
      "manifest": "version: 1\nagents:\n  alpha: {}\n",
      "entries": [
        {
          "path": "/moldea/agents/alpha/description.md",
          "type": "file",
          "text": "Use {{ examples }} to annotate the project.\n"
        },
        {
          "path": "/moldea/agents/alpha/instruction.md",
          "type": "file",
          "text": "You are the `alpha` agent.\n😀 {{USED}}{{UNKNOWN}} {{bad}} }}\n"
